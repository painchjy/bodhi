[Unit]
Description=IT platform MCP (reference implementation for intranet systems)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/c/Users/PHJY/source/bodhi2
EnvironmentFile=/mnt/c/Users/PHJY/source/bodhi2/.env
ExecStart=/usr/bin/python3 tools/it-platform-mcp/server.py --host 0.0.0.0 --port 8770
Restart=always
RestartSec=5
StandardOutput=append:/var/log/bodhi-it-mcp.log
StandardError=append:/var/log/bodhi-it-mcp.err.log

[Install]
WantedBy=multi-user.target
