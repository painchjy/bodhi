# =====================================================================
# bodhi2 · deploy 环境变量模板
# ---------------------------------------------------------------------
# 用法（Windows PowerShell，在仓库根目录）：
#   Copy-Item deploy/.env.example deploy/.env
#   （然后按注释改密码；deploy/.env 已被 .gitignore 忽略，不会入库）
#
# 本文件服务三种用法：
#   1) 拓扑 B —— 本仓库自持图库：cd deploy; docker compose up -d
#   2) 拓扑 A —— 叠加到上游 WeKnora 自带 Neo4j：
#      deploy/docker-compose.weknora.yml（变量取上游 .env，见 deploy/README.md）
#   3) WeKnora 侧的连接参数（NEO4J_ENABLE / NEO4J_URI / NEO4J_USERNAME /
#      NEO4J_PASSWORD）写在上游仓库的 .env 里，取值必须与本文件一致。
# =====================================================================

# ========== 1. 图库镜像与端口 ==========
# 本体投影（00_constraints.cypher）用的是 Neo4j 5 语法
# （CREATE CONSTRAINT ... IF NOT EXISTS ... REQUIRE ... IS UNIQUE），
# 4.x 起不来；如需与上游 neo4j 服务同版本，覆盖此值即可。
NEO4J_IMAGE=neo4j:5-community

# 宿主机映射端口（与上游 `--profile neo4j` 起的 Neo4j 冲突时改这里）
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ========== 2. 图库认证 ==========
# 官方镜像只认 NEO4J_AUTH=neo4j/<password>，初始用户名固定 neo4j（改用户名无效）。
NEO4J_USERNAME=neo4j

# ⚠️ 仅 POC 默认值，生产必须改。必须与上游 WeKnora .env 的 NEO4J_PASSWORD 一致，
#    否则 WeKnora 与本仓库连的不是同一张图（本体约束就管不住实例）。
NEO4J_PASSWORD=CHANGE_ME

# ========== 3. 本体投影灌库 ==========
# 灌库容器连接串。同 compose 网络用服务名；跨 compose 项目（WeKnora 在别处）用宿主端口：
#   Docker Desktop : bolt://host.docker.internal:7687
#   Linux          : bolt://<宿主机IP>:7687
# 上游 docs/KnowledgeGraph.md 给的默认值就是 bolt://neo4j:7687（服务 DNS 名 neo4j）。
NEO4J_URI=bolt://neo4j:7687

# Cypher 产物目录。默认 ../artifacts/neo4j 相对 deploy/ 解析，无需改动；
# 只在「叠加到上游 compose」或 artifacts 放在别处时才需要显式指定绝对路径
# （路径用正斜杠，Docker Desktop 接受 C:/... 形式）。
# BODHI_NEO4J_CYPHER_DIR=C:/Users/PHJY/source/bodhi2/artifacts/neo4j

# 仅在「叠加到上游 compose」时必填：本仓库 deploy/ 目录的绝对路径
# （docker-compose.weknora.yml 用它挂载 bootstrap-neo4j.sh）。
# BODHI_DEPLOY_DIR=C:/Users/PHJY/source/bodhi2/deploy
