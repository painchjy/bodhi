[Unit]
Description=bodhi2 ontology MCP (8765)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/bodhi2
EnvironmentFile=-/opt/bodhi2/config/common.env
EnvironmentFile=-/opt/bodhi2/config/mcp.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/bin/mkdir -p /opt/bodhi2/logs
ExecStart=/usr/bin/python3 /opt/bodhi2/tools/ontology-mcp/server.py --host 0.0.0.0 --port 8765
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/opt/bodhi2/logs/bodhi2-mcp.log
StandardError=append:/opt/bodhi2/logs/bodhi2-mcp.err.log

[Install]
WantedBy=multi-user.target
