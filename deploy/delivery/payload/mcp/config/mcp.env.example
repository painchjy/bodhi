# bodhi-mcp（8765）配置：知识库、本体投影、写入开关
BODHI_ONTOLOGY_KB_ID=
BODHI_ONTOLOGY_KB_NAME=企业本体模型
BODHI_CONCEPT_KB_ID=
BODHI_CONCEPT_KB_NAME=企业共享概念模型
BODHI_METHOD_KB_NAME=企业知识管理领域
BODHI_TENANT_ID=
# systemd 服务运行在宿主机；Neo4j 不部署可保持默认，部署则填宿主机可达地址
