# 02 公共数据库配置（bodhi-mcp / agent_diag / analytics-admin / diag-init 共用）
# 复制为 config/common.env 后修改；不要提交真实口令。
# systemd 服务运行在宿主机：这里必须用宿主机可达地址，不能写容器 DNS 名。
# 若 WeKnora Postgres 只在 Docker 内，请先把 127.0.0.1:5432 映射到宿主机。
BODHI_DB_HOST=127.0.0.1
BODHI_DB_PORT=5432
BODHI_DB_USER=postgres
BODHI_DB_PASSWORD=CHANGE_ME
BODHI_DB_NAME=WeKnora
BODHI_DB_CONTAINER=WeKnora-postgres
# WEKNORA_NETWORK 仅 Docker 部署使用，systemd 模式忽略
