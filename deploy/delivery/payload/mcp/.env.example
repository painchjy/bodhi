# =============================================================================
# bodhi2 环境变量模板（唯一清单；复制为 .env 后按环境修改）
# ---------------------------------------------------------------------------
# 复制：
#   cp .env.example .env
#
# 说明：
#   · 本文件只列 bodhi2 / MCP 服务自身变量；WeKnora 上游的 LLM、Milvus、
#     MinIO 等变量仍在 WeKnora 自己的 .env，不在这里重复。
#   · 值后面不要写行尾注释（systemd EnvironmentFile 不会剥掉）。
#   · 不要提交真实 .env；本文件中的 KEY/PASSWORD 全部是占位符。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 知识库与租户
# -----------------------------------------------------------------------------
# 本体模型库：ID 优先；没有 ID 时按名称识别
BODHI_ONTOLOGY_KB_ID=
BODHI_ONTOLOGY_KB_NAME=企业本体模型
# 兼容旧脚本（二者任选，建议用 BODHI_ONTOLOGY_KB_ID）
# ONTOLOGY_KB_ID=

# 企业共享概念模型（跨库上下文映射）
BODHI_CONCEPT_KB_ID=
BODHI_CONCEPT_KB_NAME=企业共享概念模型
# 兼容旧写法
# BODHI_CONCEPT_KB=

# 方法层领域库；建模智能体的任务页在这里
BODHI_METHOD_KB=
BODHI_METHOD_KB_NAME=企业知识管理领域
BODHI_DOMAIN_KB_NAME=
BODHI_WORK_KB_NAME=

# 调用者租户（写权限判定；请求头 X-Bodhi-Tenant 也可覆盖）
BODHI_TENANT_ID=

# 规则默认 spec（调用方不传 spec 时使用；没有默认规则就留空）
BODHI_DEFAULT_RULE_SPEC=

# -----------------------------------------------------------------------------
# 2. PostgreSQL（WeKnora 主库）
# -----------------------------------------------------------------------------
# 容器/远端部署：设置 BODHI_DB_HOST 走 TCP 直连；
# 留空则回退 docker exec <BODHI_DB_CONTAINER> psql（仅本机开发）
BODHI_DB_HOST=
BODHI_DB_PORT=5432
BODHI_DB_USER=postgres
BODHI_DB_PASSWORD=CHANGE_ME
BODHI_DB_NAME=WeKnora
BODHI_DB_CONTAINER=WeKnora-postgres
# KB 缓存秒数（0=不缓存）
BODHI_KB_CACHE_TTL=60

# -----------------------------------------------------------------------------
# 3. Neo4j（本体投影；不部署则读接口会降级/跳过）
# -----------------------------------------------------------------------------
BODHI_NEO4J_HTTP=http://127.0.0.1:7474
BODHI_NEO4J_DB=neo4j
BODHI_NEO4J_CYPHER_DIR=
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME
# 仅 docker compose 部署时用
NEO4J_IMAGE=neo4j:5-community
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
BODHI_DEPLOY_DIR=

# -----------------------------------------------------------------------------
# 4. 外部 IT 平台 / 文档服务（04）
# -----------------------------------------------------------------------------
IT_MCP_HOST=127.0.0.1
IT_MCP_PORT=8770
IT_MCP_QUIET=0
IT_MCP_PUBLIC_BASE=http://127.0.0.1:8770
# 04 服务自身监听（如不使用独立部署可忽略）
IT_PLATFORM_HOST=127.0.0.1
IT_PLATFORM_PORT=8770
BODHI_EXT_ROOT=/var/lib/bodhi-ext
BODHI_EXT_SEED=/opt/bodhi-ext/deploy/mock-ext
BODHI_EXT_SERVICE_URLS=
BODHI_IT_PLATFORM_SCHEMA=
BODHI_DOMAIN_LIB=

# -----------------------------------------------------------------------------
# 5. 文档解析 / 图片（PDF、DOCX、VLM 识图）
# -----------------------------------------------------------------------------
BODHI_DOC_ROOT=
BODHI_DOC_CACHE=1
BODHI_DOC_FETCH_TIMEOUT=90
BODHI_IMAGE_ROOT=
BODHI_PDF_TIMEOUT=90
BODHI_PDF_MAX_IMAGE_PAGES=20
BODHI_PDF_AUTO_IMAGES_MB=10
BODHI_IMG_MAX_SIDE=1400
BODHI_VLM_SHRINK_TIMEOUT=60

# 图片识图（DeepSeek 示例；换供应商就改 base_url/model）
BODHI_VLM_BASE_URL=https://api.deepseek.com/
BODHI_VLM_MODEL=deepseek-flash
BODHI_VLM_API_KEY=CHANGE_ME
BODHI_VLM_TIMEOUT=300
BODHI_VLM_MAX_KB=250
BODHI_VLM_MAX_SIDE=1600
BODHI_VLM_THINKING=disabled
BODHI_VLM_MAX_TOKENS=6144
BODHI_VLM_RPM=6
BODHI_VLM_WAIT_MAX=120
# 排障：1=把每次实际发送的 VLM body 落到 state/doc_parse/vlm/*.request.attemptN.json
# 文件含原图 base64，仅本机诊断用，勿进交付包/仓库
BODHI_VLM_DUMP_REQUEST=0

# 外部参考规范直连（白名单才允许；不能直连就留空）
BODHI_REF_HOSTS=
BODHI_REF_HOST_IP=
BODHI_REF_TIMEOUT=8
BODHI_HTTP_PROXY=

# -----------------------------------------------------------------------------
# 6. 建模 / 检索开关与预算
# -----------------------------------------------------------------------------
BODHI_ONTOLOGY_HINT=abtest
BODHI_AB_ROTATION=hash
# 工具回执：full=保留 hint/next/why（外网调试）；compact=只回数据/错误（内网，任务步骤要精确）
BODHI_RECEIPT_MODE=full
BODHI_CHARS_PER_TOKEN=1.6
BODHI_ROUND_BUDGET_TOKENS=8000
BODHI_STRICT_RELATIONS=0
BODHI_VALIDATE_FROM_GRAPH=1
BODHI_DEFER_MAINTENANCE=1
BODHI_DEBUG_ENGINE=0
# 默认 1（单租户/本机）；生产按需收紧为 0
BODHI_OPEN_WRITE_ACL=1

# 文本相似度/真值评测（可选）
BODHI_EMBED_BASE_URL=
BODHI_EMBED_MODEL=
BODHI_EMBED_API_KEY=

# -----------------------------------------------------------------------------
# 7. WeKnora 集成 / 容器名
# -----------------------------------------------------------------------------
BODHI_WEKNORA_DIR=
WEKNORA_DIR=
WEKNORA_NETWORK=weknora-network
WEKNORA_APP_CONTAINER=WeKnora-app
WEKNORA_DOCREADER_CONTAINER=WeKnora-docreader

# -----------------------------------------------------------------------------
# 8. CLI / 诊断 / 回归测试（可选）
# -----------------------------------------------------------------------------
BODHI_HTTP_BASE=http://127.0.0.1:8765
BODHI_MCP_URL=http://127.0.0.1:8765/mcp
BODHI_TEST_ONTOLOGY_UPLOAD=0
BODHI_RULE_REG_KB=
BODHI_RULE_REG_REVIEW=
BODHI_DIR=/opt/bodhi2
BODHI_REPO=
BODHI_PY=python3
