# bodhi2 MCP 服务配置（复制成 .env 后改这几项即可）
#
# 数据库：容器/远端部署**必须**设 BODHI_DB_HOST（走 TCP 直连）；
#         留空则回退到 `docker exec <BODHI_DB_CONTAINER> psql`（本机开发用，容器里不可用）。
BODHI_DB_HOST=postgres
BODHI_DB_PORT=5432
BODHI_DB_USER=postgres
BODHI_DB_PASSWORD=CHANGE_ME
BODHI_DB_NAME=WeKnora

# 仅 docker-exec 模式（BODHI_DB_HOST 为空）时用
BODHI_DB_CONTAINER=WeKnora-postgres

# Neo4j 本体投影（**可选**；不部署 Neo4j 就保持默认，相关巡检项会被跳过/报"取不到投影"）
BODHI_NEO4J_HTTP=http://neo4j:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME
BODHI_NEO4J_DB=neo4j

# WeKnora 侧需要放行 MCP 主机名（若 MCP URL 用容器 DNS 则不需要）
WEKNORA_NETWORK=weknora-network

# ── 本体模型知识库的识别（可选；不设也能按「库名 / ontology:* 页数」自动认）────────────
# 你们的本体模型知识库 uuid：前端「上传本体文件」按钮与 MCP 默认操作库都按它认库。
# 也可以不设，改为给库打标记：
#   UPDATE knowledge_bases SET wiki_config = COALESCE(wiki_config,'{}'::jsonb)
#     || '{"bodhi_ontology_kb": true}'::jsonb WHERE id='<本体库 uuid>';
# BODHI_ONTOLOGY_KB_ID=
# BODHI_ONTOLOGY_KB_NAME=企业本体模型
