# bodhi2 MCP 服务配置（复制成 .env 后改这几项即可）
#
# bodhi2 MCP 服务配置（唯一事实源 = 本文件；2026-09-29 用户口径）
#   · MCP 服务：systemd/容器都读本文件（systemd 用 EnvironmentFile=，不重复配置）
#   · CLI / 脚本：ke_db.env_value() 也读本文件 → 两边配置天然一致
#   · 不含任何密钥：DB 口令与 Neo4j 凭据来自 WeKnora 的 .env / 运行环境
#   · LLM / 嵌入参数已退役（MCP 不调用大模型；模型能力由 WeKnora 提供）

# 两个治理知识库（env 全局指定、唯一权威；wiki_config 标记只是未配 env 时的兜底）
BODHI_ONTOLOGY_KB_ID=
BODHI_ONTOLOGY_KB_NAME=企业本体模型
BODHI_CONCEPT_KB_ID=
BODHI_CONCEPT_KB_NAME=企业共享概念模型
# 调用者租户（写权限判定；MCP 服务按租户注册时也可用请求头 X-Bodhi-Tenant 传）
BODHI_TENANT_ID=

# 数据库（容器/远端部署必须设 BODHI_DB_HOST 走 TCP 直连；留空则 docker exec psql）
BODHI_DB_HOST=postgres
BODHI_DB_PORT=5432
BODHI_DB_USER=postgres
BODHI_DB_PASSWORD=CHANGE_ME
BODHI_DB_NAME=WeKnora
# 仅 docker-exec 模式（BODHI_DB_HOST 为空）时用
BODHI_DB_CONTAINER=WeKnora-postgres

# Neo4j（本体投影，只读查询；默认 http://127.0.0.1:7474 + neo4j）
BODHI_NEO4J_HTTP=http://neo4j:7474
BODHI_NEO4J_DB=neo4j

#         留空则回退到 `docker exec <BODHI_DB_CONTAINER> psql`（本机开发用，容器里不可用）。
BODHI_DB_HOST=postgres
BODHI_DB_PORT=5432
BODHI_DB_USER=postgres
BODHI_DB_PASSWORD=CHANGE_ME
BODHI_DB_NAME=WeKnora

# 仅 docker-exec 模式（BODHI_DB_HOST 为空）时用
BODHI_DB_CONTAINER=WeKnora-postgres

# Neo4j 本体投影（**可选**；不部署 Neo4j 就保持默认，相关巡检项会被跳过/报"取不到投影"）
BODHI_NEO4J_HTTP=http://neo4j:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME
BODHI_NEO4J_DB=neo4j

# WeKnora 侧需要放行 MCP 主机名（若 MCP URL 用容器 DNS 则不需要）
WEKNORA_NETWORK=weknora-network

# ── 本体模型知识库的识别（可选；不设也能按「库名 / ontology:* 页数」自动认）────────────
# 你们的本体模型知识库 uuid：前端「上传本体文件」按钮与 MCP 默认操作库都按它认库。
# 也可以不设，改为给库打标记：
#   UPDATE knowledge_bases SET wiki_config = COALESCE(wiki_config,'{}'::jsonb)
#     || '{"bodhi_ontology_kb": true}'::jsonb WHERE id='<本体库 uuid>';
BODHI_ONTOLOGY_KB_ID=08810cbd-af86-48d1-bd25-3b2c338e3d68
BODHI_ONTOLOGY_KB_NAME=企业本体模型
# 企业共享概念模型（跨库上下文映射的落点；env 为唯一权威）
BODHI_CONCEPT_KB_ID=
BODHI_CONCEPT_KB_NAME=企业共享概念模型
# 调用者租户（MCP 服务按租户注册时也可用头 X-Bodhi-Tenant 传）
BODHI_TENANT_ID=

# ── 落库与热路径开关（2026-10-10；默认值即"最省"口径，一般不用改）──────────────
# 注：落库**只走契约内核**（统一写序 + 批量写 PG + 失败只丢当前条）；`BODHI_SAVE_ENGINE` 已删除。
# 相似度合并：0 = 停用（一律按 (kb, slug) 幂等 upsert；相似度治理交巡检/运维）｜1 = 旧行为
BODHI_SIMILARITY_MERGE=0
# 关系 domain/range 校验的类型读：1 = 图优先（1 次 Neo4j，省掉每条边 2 次 psql）｜0 = 只用 PG
BODHI_VALIDATE_FROM_GRAPH=1
# 重型维护（全库目录树重建 / CRUD 矩阵）延迟到前端按需刷新：1 = 延迟｜0 = 落库时同步做
BODHI_DEFER_MAINTENANCE=1
# 内核路径内部调试打印（排障用；平时保持 0）
BODHI_DEBUG_ENGINE=0
