# Copy to /etc/dsdf-mcp.env, then fill in the DSDF DWS connection values.
DSDF_MCP_HOST=0.0.0.0
DSDF_MCP_PORT=8772

DSDF_DB_HOST=172.18.0.7
DSDF_DB_PORT=5432
DSDF_DB_NAME=WeKnora
DSDF_DB_USER=postgres
DSDF_DB_PASSWORD=

DSDF_JDBC_DRIVER=org.postgresql.Driver
DSDF_JDBC_JAR=/opt/dsdf-mcp/lib/postgresql-42.5.1.jar

DSDF_SERVICE_ID=dsdf
DSDF_SERVICE_NAME="DSDF DWS"
DSDF_SERVICE_SCOPE=
