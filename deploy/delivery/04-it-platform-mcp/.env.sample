# it-platform MCP（ext 台账/文档/流程）环境
# ---------------------------------------------------------------
# 只放**本服务自己**的配置；WeKnora 的连接串在 02 包（bodhi-mcp）里那份 .env
# 说明：`BODHI_EXT_ROOT` 是**业务数据容器根**（台账/文档/状态）；
#       `BODHI_EXT_SEED` 指种子目录（默认随包的 deploy/mock-ext），只补缺失不覆盖。
BODHI_EXT_ROOT=/var/lib/bodhi-ext
BODHI_EXT_SEED=/opt/bodhi-ext/deploy/mock-ext
IT_PLATFORM_HOST=127.0.0.1
IT_PLATFORM_PORT=8766
# 台账/流程 JSON 的租户隔离（与 WeKnora 租户一致；默认 10000）
BODHI_TENANT_ID=10000
