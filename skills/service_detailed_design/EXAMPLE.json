{
  "_comment": "服务详细设计样例（真实数据：企业知识库的「身份三要素采集服务」）。用法：save_knowledge(stage=\"graph\", mode=\"apply\", nodes=…, edges=…)；kb_id 换成目标库。注意 report.upstream 传「服务页 + 报告页」，新页才能继承 source_refs（否则巡检 C1）。",
  "kb_id": "<KB_ID>",
  "model": "ea",
  "stage": "graph",
  "mode": "apply",
  "report": {
    "upstream": [
      "ea/mcpservice/身份三要素采集服务",
      "ea/summary/<报告页 slug>"
    ]
  },
  "nodes": [
    {"name": "身份三要素采集服务", "type": "ea:MCPService",
     "purpose": "采集客户姓名、证件种类、证件号码三要素，做格式与枚举校验后形成待核查的三要素",
     "definition": "（复用既有服务页定义原文，避免被改短）"},
    {"name": "客户信息", "type": "ea:BusinessEntity", "definition": "（复用既有实体页定义原文）"},

    {"name": "客户编号", "type": "easvc:BusinessAttribute",
     "definition": "客户信息实体的唯一编号（由 ECIF 分配）",
     "attributes": {"easvc:keyRole": "PK"}},
    {"name": "客户姓名", "type": "easvc:BusinessAttribute", "definition": "三要素之一：客户姓名",
     "attributes": {"easvc:keyRole": "NONE"}},
    {"name": "证件种类", "type": "easvc:BusinessAttribute", "definition": "三要素之一：证件种类枚举",
     "attributes": {"easvc:keyRole": "NONE"}},
    {"name": "证件号码", "type": "easvc:BusinessAttribute",
     "definition": "三要素之一：证件号码（与证件种类构成候选键）",
     "attributes": {"easvc:keyRole": "UNIQUE"}},
    {"name": "渠道补充信息", "type": "easvc:BusinessAttribute",
     "definition": "渠道侧补充信息（性别、出生日期、地址、电子邮箱、职业等）",
     "attributes": {"easvc:keyRole": "NONE"}},

    {"name": "采集三要素", "type": "easvc:ServiceOperation",
     "definition": "受理客户提交的姓名/证件种类/证件号码与可选补充信息，形成待核查三要素",
     "attributes": {"easvc:operationMethod": "MCP tool: collectIdentityTriplet",
                    "easvc:isIdempotent": "true", "easvc:transactionBoundary": "single"}},
    {"name": "校验三要素格式", "type": "easvc:ServiceOperation",
     "definition": "对三要素做格式校验与证件种类枚举校验（不落库）",
     "attributes": {"easvc:operationMethod": "纯函数: validateTriplet",
                    "easvc:isIdempotent": "true", "easvc:transactionBoundary": "none"}},
    {"name": "查询待核查三要素", "type": "easvc:ServiceOperation",
     "definition": "按客户编号读取该客户当前待核查的三要素与补充信息",
     "attributes": {"easvc:operationMethod": "MCP tool: getPendingIdentity",
                    "easvc:isIdempotent": "true", "easvc:transactionBoundary": "none"}}
  ],
  "edges": [
    {"source": "客户信息", "type": "easvc:hasBusinessAttribute", "target": "客户编号"},
    {"source": "客户信息", "type": "easvc:hasBusinessAttribute", "target": "客户姓名"},
    {"source": "客户信息", "type": "easvc:hasBusinessAttribute", "target": "证件种类"},
    {"source": "客户信息", "type": "easvc:hasBusinessAttribute", "target": "证件号码"},
    {"source": "客户信息", "type": "easvc:hasBusinessAttribute", "target": "渠道补充信息"},
    {"source": "客户编号", "type": "easvc:attributeOf", "target": "客户信息"},
    {"source": "客户姓名", "type": "easvc:attributeOf", "target": "客户信息"},
    {"source": "证件种类", "type": "easvc:attributeOf", "target": "客户信息"},
    {"source": "证件号码", "type": "easvc:attributeOf", "target": "客户信息"},
    {"source": "渠道补充信息", "type": "easvc:attributeOf", "target": "客户信息"},

    {"source": "身份三要素采集服务", "type": "easvc:serviceHasOperation", "target": "采集三要素"},
    {"source": "身份三要素采集服务", "type": "easvc:serviceHasOperation", "target": "校验三要素格式"},
    {"source": "身份三要素采集服务", "type": "easvc:serviceHasOperation", "target": "查询待核查三要素"},
    {"source": "身份三要素采集服务", "type": "easvc:serviceOwnsEntity", "target": "客户信息"},

    {"source": "采集三要素", "type": "easvc:operationOperatesOnAttribute", "target": "客户姓名",
     "properties": {"easvc:crudKind": "C"}},
    {"source": "采集三要素", "type": "easvc:operationOperatesOnAttribute", "target": "证件种类",
     "properties": {"easvc:crudKind": "C"}},
    {"source": "采集三要素", "type": "easvc:operationOperatesOnAttribute", "target": "证件号码",
     "properties": {"easvc:crudKind": "C"}},
    {"source": "采集三要素", "type": "easvc:operationOperatesOnAttribute", "target": "渠道补充信息",
     "properties": {"easvc:crudKind": "C"}},
    {"source": "校验三要素格式", "type": "easvc:operationOperatesOnAttribute", "target": "客户姓名",
     "properties": {"easvc:crudKind": "R"}},
    {"source": "校验三要素格式", "type": "easvc:operationOperatesOnAttribute", "target": "证件种类",
     "properties": {"easvc:crudKind": "R"}},
    {"source": "校验三要素格式", "type": "easvc:operationOperatesOnAttribute", "target": "证件号码",
     "properties": {"easvc:crudKind": "R"}},
    {"source": "查询待核查三要素", "type": "easvc:operationOperatesOnAttribute", "target": "客户编号",
     "properties": {"easvc:crudKind": "R"}},
    {"source": "查询待核查三要素", "type": "easvc:operationOperatesOnAttribute", "target": "客户姓名",
     "properties": {"easvc:crudKind": "R"}},
    {"source": "查询待核查三要素", "type": "easvc:operationOperatesOnAttribute", "target": "渠道补充信息",
     "properties": {"easvc:crudKind": "R"}}
  ]
}
