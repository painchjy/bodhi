artifacts/

# 知识库导出产物（kb_export 落这里；kb_upload 的接收目录也在其中）
exports/

*.py[cod]

# 虚拟环境与编辑器
.venv/
.idea/
.vscode/

# 部署本地配置：含图库密码，只入库模板 deploy/.env.example
