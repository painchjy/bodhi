256::realizesProcess rdf:type owl:ObjectProperty ;
257-    rdfs:label "实现行动方案"@zh ;
258-    rdfs:domain :BusinessProcess ;
259-    rdfs:range :CourseOfAction ;
263::definesOffering rdf:type owl:ObjectProperty ;
