235::governs rdf:type owl:ObjectProperty ;
236-    rdfs:label "管辖"@zh ;
237-    rdfs:domain :Directive ;
238-    rdfs:range :CourseOfAction ;
239-    rdfs:comment "一个指导规范管辖行动方案"@zh ;
243::isSourceOf rdf:type owl:ObjectProperty ;
244-    rdfs:label "是...的来源"@zh ;
245-    rdfs:domain :Directive ;
246-    rdfs:range :CourseOfAction ;
247-    rdfs:comment "一个指导规范可能是行动方案的来源"@zh .
250::realizedBy rdf:type owl:ObjectProperty ;
251-    rdfs:label "由...实现"@zh ;
252-    rdfs:domain :CourseOfAction ;
253-    rdfs:range :BusinessProcess ;
