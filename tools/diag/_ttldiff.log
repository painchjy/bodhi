
===== ontology/sources/bmm.ttl =====
--- before
+++ after
@@ -5,4 +5,5 @@
 @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
 @prefix bodhi: <http://example.org/bodhi#> .
+@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
 
 <http://example.org/bmm> rdf:type owl:Ontology ;
@@ -654,7 +655,7 @@
 :wikiContent rdf:type owl:DatatypeProperty ;
     rdfs:label "正文"@zh ;
-    rdfs:domain :Assessment ;
-    rdfs:range xsd:string ;
-    rdfs:comment "文档类的整篇正文（Markdown）。**有它的类按 document 渲染**：评估/评审报告这类半结构化知识——正文是主体，数据属性只做结构化摘要；其余类不要用本属性（它们是 entity，正文由数据属性生成）。"@zh .
+    rdfs:domain :Report ;
+    rdfs:range xsd:string ;
+    rdfs:comment "报告类的整篇正文（Markdown）。**声明它的类（或祖先）按 document 渲染**：报告是正文主体、数据属性只做结构化摘要；entity 类不要用本属性。"@zh .
 
 :sessionFor rdf:type owl:ObjectProperty ;
@@ -674,2 +675,19 @@
 # 模块短名（目录名/列表名；≤16 字符，导入时校验）
 <http://example.org/bmm> bodhi:shortName "BMM业务动机模型" .
+
+# ============================================================
+### 36. 报告基类 Report（2026-10-11 新增）
+# **过程件基类**：报告/方案/评审/结项等**整篇正文**的载体，给人讨论·评审·反馈·溯源·取证；
+# **不参与机器判定**（机器判定只读 entity 资产）。谁继承它，谁就按 `document` 渲染
+# （`ke_ontology.render_mode` 的判据：类或祖先声明了带 domain 的 `wikiContent`）。
+:Report rdf:type owl:Class ;
+    rdfs:label "报告"@zh ;
+    rdfs:comment "过程件基类：承载整篇正文，供人讨论·评审·反馈·溯源·取证；不参与机器判定。继承它的类按 document 渲染。"@zh ;
+    rdfs:subClassOf owl:Thing .
+
+### 37. 需求分析报告 RequirementAnalysisReport（2026-10-11 新增；别名：需求规格说明书）
+:RequirementAnalysisReport rdf:type owl:Class ;
+    rdfs:label "需求分析报告"@zh ;
+    skos:altLabel "需求规格说明书"@zh ;
+    rdfs:comment "「立项与需求分析」活动的产出：范围/目标/边界/需求项与验收口径；是后续设计（设计单）的依据。"@zh ;
+    rdfs:subClassOf :Report .


===== ontology/sources/agent.ttl =====
--- before
+++ after
@@ -64,5 +64,5 @@
     rdfs:label "设计单"@zh ;
     rdfs:comment "业务智能体/业务技能的设计（目标、触发、技能面、工具面、**工作知识库范围**、人机分工），人工确认后才进入开发；落「领域知识库」。"@zh ;
-    rdfs:subClassOf owl:Thing .
+    rdfs:subClassOf bmm:Report .
 
 ### 6. 安装指引 InstallGuide
@@ -70,5 +70,5 @@
     rdfs:label "安装指引"@zh ;
     rdfs:comment "交付给业务方的配置与安装说明：依赖/技能安装/库与模型配置/**工具状态表（挡板 or 已投产）**/验证步骤。"@zh ;
-    rdfs:subClassOf owl:Thing .
+    rdfs:subClassOf bmm:Report .
 
 ### 7. 工具契约 ToolContract
@@ -111,5 +111,5 @@
     rdfs:label "评测"@zh ;
     rdfs:comment "一次效果评测（闭环一的收尾）：固定指标口径、反例、结论与受限项清单，可复现；落「领域知识库」。"@zh ;
-    rdfs:subClassOf owl:Thing .
+    rdfs:subClassOf bmm:Report .
 
 ### 12. 指标 Metric
@@ -123,5 +123,5 @@
     rdfs:label "改进建议"@zh ;
     rdfs:comment "闭环一的出口物、闭环二的入口物：现象+证据+涉及对象+不确定性类型+影响面+期望改动+优先级+状态；**被驳回的也要留痕**；落「领域知识库」，可回到产生它的会话。"@zh ;
-    rdfs:subClassOf owl:Thing .
+    rdfs:subClassOf bmm:Report .
 
 # ============================================================
@@ -362,9 +362,12 @@
 @prefix bmm: <http://example.org/bmm#> .
 
-bmm:wikiContent rdfs:domain :Advice ;
-    rdfs:domain :DesignSpec ;
-    rdfs:domain :Evaluation ;
-    rdfs:domain :InstallGuide .
+# 2026-10-11：报告类改为**继承** `bmm:Report`（见上方 4 个类的 subClassOf），不再逐个追加 domain。
 
 # 模块短名（目录名/列表名；≤16 字符，导入时校验）
 <http://example.org/agent> bodhi:shortName "智能体开发本体" .
+
+### 报告·评测方案 EvaluationPlan（2026-10-11 新增）
+:EvaluationPlan rdf:type owl:Class ;
+    rdfs:label "评测方案"@zh ;
+    rdfs:comment "「开发交付」活动的产出、「评测」活动的输入：指标/用例/样本/通过门槛（对齐 agent:Metric）。"@zh ;
+    rdfs:subClassOf bmm:Report .


