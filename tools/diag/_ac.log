=== ④ ke_graph.rebuild_kb_wiki 全文 ===
    187  def rebuild_kb_wiki(kb_id: str, dry_run: bool = False) -> dict:
    188      """**图→wiki 全量重建**（S-10）：按图节点 `wiki_content` 重建 PG `wiki_pages.content`，
    189      并清空出入链（关系只在图里）。图节点无 `wiki_content` 的页（如 index/原生页）不动。"""
    190      import ke_db
    191      insts = _run("MATCH (n:BodhiInstance {kb_id:$kb}) RETURN n.slug AS slug, n.wiki_content AS wc",
    192                   {"kb": kb_id})
    193      wc_map = {r["slug"]: (r.get("wc") or "") for r in insts}
    194      rows = ke_db.psql_csv(
    195          "SELECT slug, COALESCE(content,'') AS content FROM wiki_pages "
    196          "WHERE knowledge_base_id = %s AND deleted_at IS NULL" % ke_db.sql_str(kb_id))
    197      changed = 0
    198      for r in rows:
    199          wc = wc_map.get(r["slug"])
    200          if wc is None:
    201              continue
    202          if wc != r["content"]:
    203              changed += 1
    204          if not dry_run:
    205              ke_db.psql(
    206                  "UPDATE wiki_pages SET content = %s, out_links = '[]'::jsonb, in_links = '[]'::jsonb, "
    207                  "updated_at = now() WHERE knowledge_base_id = %s AND slug = %s;"
    208                  % (ke_db.sql_str(wc), ke_db.sql_str(kb_id), ke_db.sql_str(r["slug"])), stdin=True)
    209      return {"ok": True, "kb_id": kb_id, "dry_run": bool(dry_run),
    210              "pages": len(rows), "content_changed": changed}
