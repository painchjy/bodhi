[Unit]
Description=MCP Gateway (notifications shim + fixed args)
Documentation=file:/opt/bodhi-mcp-gateway/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bodhi-mcp-gateway
Environment=MCP_GATEWAY_CONFIG=/etc/bodhi-mcp-gateway.json
ExecStart=/usr/bin/python3 /opt/bodhi-mcp-gateway/server.py
Restart=always
RestartSec=3
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
