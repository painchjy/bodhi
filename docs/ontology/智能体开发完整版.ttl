@prefix : <http://example.org/agent#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bodhi: <http://example.org/bodhi#> .
@prefix bmm: <http://example.org/bmm#> .
@prefix bpmn: <http://example.org/bpmn#> .

<http://example.org/agent> rdf:type owl:Ontology ;
    rdfs:label "智能体开发本体（业务智能体 + 技能/工具开发 + 评测与改进建议）"@zh ;
    owl:versionIRI <http://example.org/agent/1.1> ;
    bodhi:expertRole "智能体架构师，精通业务智能体的技能/工具设计开发与效果评测"@zh .

# ============================================================
# 口径（2026-10-01 用户裁定，务必遵守）：
# 1) **限界上下文用「领域知识库」承担**——知识库之间不能跨库引用、本地领域方言独立，
#    天然满足 DDD 限界上下文；**上下文映射由「企业共享概念知识库」实现**
#    → **本模型不建 DDD 概念（BoundedContext/Aggregate/Entity/… 一律不要）**。
# 2) **两类闭环共 3 类知识库，不可混用**：
#    ① .env 注册的特殊知识库：**企业本体模型知识库**（手工上传维护）、
#       **企业共享概念知识库**（运维智能体维护的治理产物，**其他智能体只读**）
#    ② **领域知识库**：领域建模的目标库，也是业务智能体设计/开发用的库
#       → 业务智能体、技能、工具、评测、改进建议都在**这里**定义
#    ③ **业务智能体的工作知识库**：业务运行时新增/留存知识的库（由所在领域的领域知识库指定范围）
# 3) **本模型只描述业务智能体**；**领域建模智能体 / 设计开发智能体 / 运维智能体不进本体**
#    （它们是能力/工具，由技能与工具面表达）。
# ============================================================

# ============================================================
# 一、业务智能体与它的能力面（技能 / 工具 / MCP 服务）
# ============================================================

### 1. 业务智能体 Agent
:Agent rdf:type owl:Class ;
    rdfs:label "业务智能体"@zh ;
    rdfs:comment "承载具体业务的作业体（如技术方案评审智能体）。**只在「领域知识库」里定义**（与业务领域知识、需求天然形成溯源关系）；通过技能获得能力、通过工具获得手段，并在**由领域指定的工作知识库**里读写业务知识。"@zh ;
    rdfs:subClassOf owl:Thing .

### 2. 技能 Skill
:Skill rdf:type owl:Class ;
    rdfs:label "技能"@zh ;
    rdfs:comment "可复用的作业方法。**单一真源是仓库里的 `skills/<id>/SKILL.md`**；本体内只保存引用个体（id/路径/版本/状态），不复制正文。技能在**使用它的领域知识库**里登记（按需补充，不全集暴露）。"@zh ;
    rdfs:subClassOf owl:Thing .

### 3. 工具 Tool
:Tool rdf:type owl:Class ;
    rdfs:label "工具"@zh ;
    rdfs:comment "可被智能体调用的能力单元（MCP 工具/存量系统接口），有明确契约与**可操作的知识库角色**（识别与管控，禁止混用）；未投产前用挡板（Stub）先跑。"@zh ;
    rdfs:subClassOf owl:Thing .

### 4. MCP 服务 MCPService
:MCPService rdf:type owl:Class ;
    rdfs:label "MCP服务"@zh ;
    rdfs:comment "以 MCP 协议对外提供工具集的服务（工具清单可由服务端代码自动同步校验）。"@zh ;
    rdfs:subClassOf owl:Thing .

# ============================================================
# 二、设计开发产物（设计单 / 安装指引 / 契约 / 挡板）
# ============================================================

### 5. 设计单 DesignSpec
:DesignSpec rdf:type owl:Class ;
    rdfs:label "设计单"@zh ;
    rdfs:comment "业务智能体/业务技能的设计（目标、触发、技能面、工具面、**工作知识库范围**、人机分工），人工确认后才进入开发；落「领域知识库」。"@zh ;
    rdfs:subClassOf bmm:Report .

### 6. 安装指引 InstallGuide
:InstallGuide rdf:type owl:Class ;
    rdfs:label "安装指引"@zh ;
    rdfs:comment "交付给业务方的配置与安装说明：依赖/技能安装/库与模型配置/**工具状态表（挡板 or 已投产）**/验证步骤。"@zh ;
    rdfs:subClassOf bmm:Report .

### 7. 工具契约 ToolContract
:ToolContract rdf:type owl:Class ;
    rdfs:label "工具契约"@zh ;
    rdfs:comment "工具的接口契约（入参/出参/错误码/字段含义）。**挡板与真实实现共用同一契约**，换实现不改调用方。"@zh ;
    rdfs:subClassOf owl:Thing .

### 8. 挡板 Stub
:Stub rdf:type owl:Class ;
    rdfs:label "挡板"@zh ;
    rdfs:comment "工具投产前的模拟实现：返回值必须打标（`_mock=true`），写库/发布类默认 dry_run，不污染生产数据；替换到真实实现要留痕。"@zh ;
    rdfs:subClassOf owl:Thing .


# ============================================================
# 三、工作知识库（业务智能体运行时读写；技能/工具据此做「目标库范围」管控）
#     2026-10-04 用户口径（**取消原来的「知识库角色」词表**）：
#       · **只定义「工作知识库」**：业务智能体声明它需要使用的**工作知识库**（一库一页，标题=库名）；
#       · 技能/工具各自声明**目标工作知识库**（`skillTargetsWorkKb` / `toolTargetsWorkKb`）——
#         业务智能体执行时，就按这份清单**限定技能与工具调用的目标库范围**（管控）；
#       · **领域知识库（=本库）不进本体**：它在「业务智能体的部署提示词上下文」里明确，
#         与业务智能体的设计/部署保持一致，**不需要额外配置与管理**；
#       · 特殊知识库（企业本体模型 / 企业共享概念模型）由 `.env` 注册，
#         属**系统级常量**，不作为业务侧实例建页；两者不可混用。
#         2026-10-24（用户口径）：原「企业知识管理领域」**不再是特殊库**，按普通领域库使用 ✓
# ============================================================

### 10. 工作知识库 WorkKnowledgeBase
:WorkKnowledgeBase rdf:type owl:Class ;
    rdfs:label "工作知识库"@zh ;
    rdfs:comment "业务智能体**运行时读写**知识的库（如某次技术方案评审识别出的部署架构、技术栈信息）。**一个真实库 = 一个实例页**（标题=库名）；业务智能体只声明它用到的库，技能/工具按库名限定调用范围。**领域知识库（本库）不在此建模**（见本模型口径注释③）。"@zh ;
    rdfs:subClassOf owl:Thing .

# ============================================================
# 四、评测与改进建议（闭环一的出口 → 闭环二的入口）
# ============================================================

### 11. 评测 Evaluation
:Evaluation rdf:type owl:Class ;
    rdfs:label "评测"@zh ;
    rdfs:comment "一次效果评测（闭环一的收尾）：固定指标口径、反例、结论与受限项清单，可复现；落「领域知识库」。"@zh ;
    rdfs:subClassOf bmm:Report .


### 11.1 规则评测 RuleEvaluation（2026-10-19 新增 ✓）
:RuleEvaluation rdf:type owl:Class ;
    rdfs:label "规则评测"@zh ;
    rdfs:comment "**一条规则一组**的评测台账（`Evaluation` 的子类）：累积该规则在历次《技术方案评审报告》中的执行结果 + 知识入库情况，用于**持续跟踪**一条规则是否可信、是否可被任务步骤引用；一规则一页。"@zh ;
    rdfs:subClassOf :Evaluation .

### 12. 指标 Metric
:Metric rdf:type owl:Class ;
    rdfs:label "指标"@zh ;
    rdfs:comment "评测的固定指标（结论正确率 / 证据可回溯率 / 未知或待澄清的正确率 / 外部知识依赖数 / 单份方案耗时）。"@zh ;
    rdfs:subClassOf owl:Thing .

### 13. 改进建议 Advice
:Advice rdf:type owl:Class ;
    rdfs:label "改进建议"@zh ;
    rdfs:comment "闭环一的出口物、闭环二的入口物：现象+证据+涉及对象+不确定性类型+影响面+期望改动+优先级+状态；**被驳回的也要留痕**；落「领域知识库」，可回到产生它的会话。"@zh ;
    rdfs:subClassOf bmm:Report .

# ============================================================
# 五、对象属性（Object Properties）
# ============================================================

:agentUsesSkill rdf:type owl:ObjectProperty ;
    rdfs:label "使用技能"@zh ;
    rdfs:domain :Agent ;
    rdfs:range :Skill ;
    rdfs:comment "技能是业务智能体的能力面（技能只限模型、不限本体类型）"@zh .

:agentUsesTool rdf:type owl:ObjectProperty ;
    rdfs:label "使用工具"@zh ;
    rdfs:domain :Agent ;
    rdfs:range :Tool ;
    rdfs:comment "工具是业务智能体的手段面"@zh .

:agentUsesWorkKb rdf:type owl:ObjectProperty ;
    rdfs:label "使用工作知识库"@zh ;
    rdfs:domain :Agent ;
    rdfs:range :WorkKnowledgeBase ;
    rdfs:comment "业务智能体运行时读写知识的**工作知识库**（一库一页）。**领域知识库（本库）不在此列**——它由业务智能体的部署提示词上下文表达。"@zh .

:agentHasDesign rdf:type owl:ObjectProperty ;
    rdfs:label "有设计单"@zh ;
    rdfs:domain :Agent ;
    rdfs:range :DesignSpec ;
    rdfs:comment "业务智能体/技能的设计单（人工确认后才开发）"@zh .

:agentHasInstallGuide rdf:type owl:ObjectProperty ;
    rdfs:label "有安装指引"@zh ;
    rdfs:domain :Agent ;
    rdfs:range :InstallGuide ;
    rdfs:comment "交付给业务方的配置与安装说明"@zh .

:agentRealizesMeans rdf:type owl:ObjectProperty ;
    rdfs:label "实现手段"@zh ;
    rdfs:domain :Agent ;
    rdfs:range bmm:Means ;
    rdfs:comment "**跨层桥**：业务智能体是一种实现层手段（BMM 的手段定义含『代理人、工具、能力、方法』）—— 单向引用业务层，不做继承"@zh .

:skillTargetsWorkKb rdf:type owl:ObjectProperty ;
    rdfs:label "技能面向工作知识库"@zh ;
    rdfs:domain :Skill ;
    rdfs:range :WorkKnowledgeBase ;
    rdfs:comment "该技能的操作对象限定在哪些**工作知识库**（业务智能体执行时按此管控技能的目标库范围；**不得指向领域知识库/特殊知识库**）"@zh .

:skillUsesTool rdf:type owl:ObjectProperty ;
    rdfs:label "技能使用工具"@zh ;
    rdfs:domain :Skill ;
    rdfs:range :Tool ;
    rdfs:comment "技能在流程里调用的工具"@zh .

:toolTargetsWorkKb rdf:type owl:ObjectProperty ;
    rdfs:label "工具面向工作知识库"@zh ;
    rdfs:domain :Tool ;
    rdfs:range :WorkKnowledgeBase ;
    rdfs:comment "工具读写哪些**工作知识库**（**写类工具必须声明**；业务智能体执行时按此管控工具的目标库范围，禁止指向领域知识库/特殊知识库）"@zh .

:toolHasContract rdf:type owl:ObjectProperty ;
    rdfs:label "工具有契约"@zh ;
    rdfs:domain :Tool ;
    rdfs:range :ToolContract ;
    rdfs:comment "工具的接口契约（挡板与真实实现共用）"@zh .

:toolHasStub rdf:type owl:ObjectProperty ;
    rdfs:label "工具有挡板"@zh ;
    rdfs:domain :Tool ;
    rdfs:range :Stub ;
    rdfs:comment "未投产前的模拟实现"@zh .

:toolProvidedByMcp rdf:type owl:ObjectProperty ;
    rdfs:label "由MCP服务提供"@zh ;
    rdfs:domain :Tool ;
    rdfs:range :MCPService ;
    rdfs:comment "工具由哪个 MCP 服务提供（工具清单可从服务端自动同步校验）"@zh .

:toolHasInstallGuide rdf:type owl:ObjectProperty ;
    rdfs:label "工具有安装说明"@zh ;
    rdfs:domain :Tool ;
    rdfs:range :InstallGuide ;
    rdfs:comment "工具在安装指引中的状态与影响说明（挡板/已投产）"@zh .

:evaluationOfAgent rdf:type owl:ObjectProperty ;
    rdfs:label "评测对象智能体"@zh ;
    rdfs:domain :Evaluation ;
    rdfs:range :Agent ;
    rdfs:comment "本次评测评的是哪个业务智能体（或它的技能/工具组合）"@zh .

:evaluationMeasures rdf:type owl:ObjectProperty ;
    rdfs:label "评测指标"@zh ;
    rdfs:domain :Evaluation ;
    rdfs:range :Metric ;
    rdfs:comment "本次评测采用的指标（口径固定、可复现）"@zh .

:evaluationProducesAdvice rdf:type owl:ObjectProperty ;
    rdfs:label "评测产出建议"@zh ;
    rdfs:domain :Evaluation ;
    rdfs:range :Advice ;
    rdfs:comment "评测的出口物：改进建议（闭环二的入口）"@zh .

:adviceTargetsTool rdf:type owl:ObjectProperty ;
    rdfs:label "建议针对工具"@zh ;
    rdfs:domain :Advice ;
    rdfs:range :Tool ;
    rdfs:comment "建议指向的具体工具"@zh .

:adviceTargetsSkill rdf:type owl:ObjectProperty ;
    rdfs:label "建议针对技能"@zh ;
    rdfs:domain :Advice ;
    rdfs:range :Skill ;
    rdfs:comment "建议指向的具体技能"@zh .

:adviceFromSession rdf:type owl:ObjectProperty ;
    rdfs:label "建议来源会话"@zh ;
    rdfs:domain :Advice ;
    rdfs:range bmm:KnowledgeSession ;
    rdfs:comment "**跨模块桥**：每条建议都必须能回到产生它的会话（可溯源、可复核）"@zh .



# ============================================================
# 六、数据属性（Datatype Properties）
# ============================================================

:stubStatus rdf:type owl:DatatypeProperty ;
    rdfs:label "挡板状态"@zh ;
    rdfs:domain :Stub ;
    rdfs:range xsd:string ;
    rdfs:comment "工具实现状态。**受控取值（逐字取用，不得另建知识页）**：挡板｜已投产。替换到真实实现要留痕（会话页 + 工具类改进建议）。"@zh .

:adviceCategory rdf:type owl:DatatypeProperty ;
    rdfs:label "建议类别"@zh ;
    rdfs:domain :Advice ;
    rdfs:range xsd:string ;
    rdfs:comment "决定进入闭环二后由哪个角色处理。**受控取值（逐字取用，不得另建知识页）**：本体类（缺类/缺属性/缺词表 → 交本体建模师）｜技能类（步骤/门禁/输出契约 → 交技能维护）｜工具类（契约/挡板转真实/实现缺陷 → 交工具开发）｜知识类（缺失/过期/来源不可用 → 回到闭环一）。"@zh .

:adviceStatus rdf:type owl:DatatypeProperty ;
    rdfs:label "建议状态"@zh ;
    rdfs:domain :Advice ;
    rdfs:range xsd:string ;
    rdfs:comment "改进建议的受理状态（总览页按『待受理』滚动汇总）。**受控取值（逐字取用）**：待受理｜已受理｜已实施｜驳回。被驳回必须留痕与理由（避免反复提同一问题）。"@zh .

:skillId rdf:type owl:DatatypeProperty ;
    rdfs:label "技能编号"@zh ;
    rdfs:domain :Skill ;
    rdfs:range xsd:string ;
    rdfs:comment "技能 id（= `skills/<id>/SKILL.md` 的目录名，单一真源）" .

:skillVersion rdf:type owl:DatatypeProperty ;
    rdfs:label "技能版本"@zh ;
    rdfs:domain :Skill ;
    rdfs:range xsd:string .

:skillPath rdf:type owl:DatatypeProperty ;
    rdfs:label "技能路径"@zh ;
    rdfs:domain :Skill ;
    rdfs:range xsd:string ;
    rdfs:comment "技能真源路径，如 `skills/document_review/SKILL.md`" .

:toolId rdf:type owl:DatatypeProperty ;
    rdfs:label "工具编号"@zh ;
    rdfs:domain :Tool ;
    rdfs:range xsd:string .

:contractVersion rdf:type owl:DatatypeProperty ;
    rdfs:label "契约版本"@zh ;
    rdfs:domain :ToolContract ;
    rdfs:range xsd:string ;
    rdfs:comment "契约版本：换实现不改契约；契约变更须评审" .

:endpoint rdf:type owl:DatatypeProperty ;
    rdfs:label "服务端点"@zh ;
    rdfs:domain :MCPService ;
    rdfs:range xsd:string .

:mockSource rdf:type owl:DatatypeProperty ;
    rdfs:label "模拟数据来源"@zh ;
    rdfs:domain :Stub ;
    rdfs:range xsd:string ;
    rdfs:comment "挡板数据来源说明（如『认证清单样例』『状态机样例表』『本地队列』）" .

:stubReason rdf:type owl:DatatypeProperty ;
    rdfs:label "挡板原因"@zh ;
    rdfs:domain :Stub ;
    rdfs:range xsd:string ;
    rdfs:comment "为何先用挡板（如『依赖存量系统、投产周期长』）" .


:runAt rdf:type owl:DatatypeProperty ;
    rdfs:label "评测时间"@zh ;
    rdfs:domain :Evaluation ;
    rdfs:range xsd:string .

:adviceId rdf:type owl:DatatypeProperty ;
    rdfs:label "建议编号"@zh ;
    rdfs:domain :Advice ;
    rdfs:range xsd:string ;
    rdfs:comment "如 'A-20261001-01'" .

:adviceText rdf:type owl:DatatypeProperty ;
    rdfs:label "建议内容"@zh ;
    rdfs:domain :Advice ;
    rdfs:range xsd:string ;
    rdfs:comment "一句话说清『要改成什么』" .

:advicePriority rdf:type owl:DatatypeProperty ;
    rdfs:label "优先级"@zh ;
    rdfs:domain :Advice ;
    rdfs:range xsd:string .

:adviceImpact rdf:type owl:DatatypeProperty ;
    rdfs:label "影响面"@zh ;
    rdfs:domain :Advice ;
    rdfs:range xsd:string .

# 2026-10-11：报告类改为**继承** `bmm:Report`（见上方 4 个类的 subClassOf），不再逐个追加 domain。

# 模块短名（目录名/列表名；≤16 字符，导入时校验）
<http://example.org/agent> bodhi:shortName "智能体开发本体" .

### 报告·评测方案 EvaluationPlan（2026-10-11 新增）
:EvaluationPlan rdf:type owl:Class ;
    rdfs:label "评测方案"@zh ;
    rdfs:comment "「开发交付」活动的产出、「评测」活动的输入：指标/用例/样本/通过门槛（对齐 agent:Metric）。"@zh ;
    rdfs:subClassOf bmm:Report .

# ============ 与 BPMN 的连接（2026-10-11；本模块 imports bpmn）============
# **一条关系**连接两个模块：**智能体协助活动**（智能体的工作由技能/工具支撑，见 :agentUsesSkill / :skillUsesTool）。

:evaluationOfRule rdf:type owl:ObjectProperty ;
    rdfs:label "评测对象（规则）"@zh ;
    rdfs:comment "规则 ↔ 评测：一条规则的全部评测台账（持续跟踪 ✓）。跨库：台账在工作库，规则在领域库。"@zh ;
    rdfs:domain :RuleEvaluation ;
    rdfs:range bmm:BusinessRule .

:reportKnowledgeIngest rdf:type owl:ObjectProperty ;
    rdfs:label "报告的知识入库情况"@zh ;
    rdfs:comment "报告 ↔ 知识入库清单（DataObject）：知识入库任务完成后，报告末尾给出**规则所需知识是否入库**的清单 ✓；评测据此比对知识库实际内容，入库率纳入评测指标。"@zh ;
    rdfs:domain bmm:Report ;
    rdfs:range bpmn:DataObject .

:reportAppliesRule rdf:type owl:ObjectProperty ;
    rdfs:label "报告适用规则"@zh ;
    rdfs:comment "报告 ↔ 规则：该报告实际执行了哪些规则 ✓（用于反查**哪些报告用过这条规则**）。**规则名必须存在于领域库**，否则视为幻觉 ✗。"@zh ;
    rdfs:domain bmm:Report ;
    rdfs:range bmm:BusinessRule .

:agentAssistsActivity rdf:type owl:ObjectProperty ;
    rdfs:label "协助活动"@zh ;
    rdfs:domain :Agent ;
    rdfs:range bpmn:Activity ; 
    rdfs:comment "智能体**协助**完成活动（活动下的任务由人或智能体执行，取决于任务的**实现手段**）。"@zh .

# ============================================================
# 十、数据对象 ↔ 工具绑定（**图本绑定**，2026-10-29 用户口径）
#   口径：
#     · 绑定 = **关系实例**（有边即绑定 ✓）；一个数据对象默认**一个**工具，
#       确需多工具用边属性 `role` 区分（read / write）；
#     · 工具契约（模式 / 主键 / 输入输出 / 列清单 / hash）**一律定义在工具侧**，
#       数据对象不再记录工具的全部输入输出（`bpmn:dataObject*` 四个数据属性随之下线）；
#     · 没有绑定的数据对象 = **软定义表格**：靠 `skos:definition` / `skos:note` 说明业务定义与结构，
#       智能体按语义处理，**不调外部服务**；用户看到"该有表格却没面板"时去查绑定关系（预期排查路径 ✓）。
#   工具实例的落地：由「MCP 服务页」刷新契约时，**只同步模型中已存在的工具**
#   （`tools/list` → 更新这些工具节点的 toolSchemaHash / toolColumns …），不自动新建实例。
# ============================================================

bpmn:dataObjectBindingTool rdf:type owl:ObjectProperty ;
    rdfs:label "绑定接口工具"@zh ;
    rdfs:domain bpmn:DataObject ;
    rdfs:range :Tool ;
    rdfs:comment "数据对象通过哪个 MCP 工具读写；**有这条边即视为已绑定**。边属性可带 role（read/write）/ note。绑定决定『本系统如何操作外部工具』，不记录工具的全部输入输出。"@zh .

:toolModes rdf:type owl:DatatypeProperty ;
    rdfs:label "工具模式"@zh ;
    rdfs:domain :Tool ;
    rdfs:range xsd:string ;
    rdfs:comment "工具允许的调用模式：query（只读）/ maintain（维护），逗号分隔。"@zh .

:toolKeyFields rdf:type owl:DatatypeProperty ;
    rdfs:label "工具主键字段"@zh ;
    rdfs:domain :Tool ;
    rdfs:range xsd:string ;
    rdfs:comment "该工具的幂等/更新主键（字段名，逗号分隔）——**在工具侧统一定义**，避免不同数据对象调同一工具各写一套主键。"@zh .

:toolColumns rdf:type owl:DatatypeProperty ;
    rdfs:label "工具列清单"@zh ;
    rdfs:domain :Tool ;
    rdfs:range xsd:string ;
    rdfs:comment "契约的列清单（JSON：{order:[...],labels:{field:label}}），供报告补锚点与面板渲染；来源 = 服务端 tools/list。"@zh .

:toolInputs rdf:type owl:DatatypeProperty ;
    rdfs:label "工具入参"@zh ;
    rdfs:domain :Tool ;
    rdfs:range xsd:string ;
    rdfs:comment "工具入参契约（JSON：字段/类型/必填/枚举）。"@zh .

:toolOutputs rdf:type owl:DatatypeProperty ;
    rdfs:label "工具出参"@zh ;
    rdfs:domain :Tool ;
    rdfs:range xsd:string ;
    rdfs:comment "工具出参契约（JSON：字段/类型/含义）。"@zh .

:toolSchemaHash rdf:type owl:DatatypeProperty ;
    rdfs:label "工具契约哈希"@zh ;
    rdfs:domain :Tool ;
    rdfs:range xsd:string ;
    rdfs:comment "契约版本（`sha256:…`）——**刷新契约只更新它**（连同 toolContractAt / toolColumns），不再往页面元数据写副本。"@zh .

:toolContractAt rdf:type owl:DatatypeProperty ;
    rdfs:label "工具契约同步时间"@zh ;
    rdfs:domain :Tool ;
    rdfs:range xsd:string ;
    rdfs:comment "最近一次从服务端 tools/list 同步契约的时间。"@zh .

