@prefix : <http://example.org/bmm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bodhi: <http://example.org/bodhi#> .

<http://example.org/bmm> rdf:type owl:Ontology ;
    rdfs:label "BMM 扩展本体（含信息来源追踪与枚举类型）"@zh ;
    owl:versionIRI <http://example.org/bmm/1.2> ;
    bodhi:expertRole "企业架构分析专家，精通 BMM 业务动机模型"@zh .

# ------------------------------------------------------------
# 跨模块共享注解：专家角色
#   WeKnora 二次开发侧的抽取界面用它作为「专家角色」选项（docs/weknora-fork.md §8.5）；
#   编译器读入后随本体目录下发，不再写死在 config.py。
# ------------------------------------------------------------
bodhi:expertRole rdf:type owl:AnnotationProperty ;
    rdfs:label "专家角色"@zh ;
    rdfs:comment "定义在某模块 owl:Ontology 上的专家角色描述：抽取时模型应扮演的角色"@zh .

# ============================================================
# 一、类定义（Class Definitions）
# ============================================================

### 1. 预期成果 DesiredResult
:DesiredResult rdf:type owl:Class ;
    rdfs:label "预期成果"@zh ;
    rdfs:comment "是企业期望维持或实现的一种状态或结果"@zh ;
    rdfs:subClassOf owl:Thing .

### 2. 目的 Goal
:Goal rdf:type owl:Class ;
    rdfs:label "目的"@zh ;
    rdfs:comment "偏向长期性、定性（而非定量）、普遍性（而非具体性）以及持续性的特点"@zh ;
    rdfs:subClassOf :DesiredResult .

### 3. 目标 Objective
:Objective rdf:type owl:Class ;
    rdfs:label "目标"@zh ;
    rdfs:comment "更偏向短期性、定量（而非定性）、具体性（而非普遍性）"@zh ;
    rdfs:subClassOf :DesiredResult .

### 4. 手段 Means
:Means rdf:type owl:Class ;
    rdfs:label "手段"@zh ;
    rdfs:comment "是一种可以被调动、激活或强制执行的设备、能力、制度、技术、限制、代理人、工具或方法，用于实现预期成果"@zh ;
    rdfs:subClassOf owl:Thing .

### 5. 行动方案 CourseOfAction
:CourseOfAction rdf:type owl:Class ;
    rdfs:label "行动方案"@zh ;
    rdfs:comment "是一种手段，指通过配置企业某些方面（涉及事物、流程、地点、人员、时间或动机）来实现目标的业务流程或业务计划，可以体现为一个项目或一份需求。为确保行动方案取得成功，其实施过程需遵循相关指导规范。"@zh ;
    rdfs:subClassOf :Means .

### 8. 指导规范 Directive
:Directive rdf:type owl:Class ;
    rdfs:label "指导规范"@zh ;
    rdfs:comment "是一种手段，用于定义或约束企业的某些方面。其目的在于确立业务结构，或控制、影响企业的行为，一般采用声明式表述形式。指导规范规定了行动方案的执行方式——即明确行动方案的执行规范。另一方面，行动方案可能源于指导规范。"@zh ;
    rdfs:subClassOf :Means .

### 9. 业务政策 BusinessPolicy
:BusinessPolicy rdf:type owl:Class ;
    rdfs:label "业务政策"@zh ;
    rdfs:comment "是一种指导规范，用于控制、影响或规范企业及其人员的行为，并不具备直接强制执行的可能性。企业政策的目的是对企业进行管理或指导。'不可直接强制执行'意味着需要对指令进行某种解释（例如通过业务规则）才能发现违规行为。特点：结构更松散、不那么明确具体、不具备原子性、不要求使用标准业务术语。"@zh ;
    rdfs:subClassOf :Directive .

### 10. 业务规则 BusinessRule
:BusinessRule rdf:type owl:Class ;
    rdfs:label "业务规则"@zh ;
    rdfs:comment "是一个切实可行的指导规范——即无需额外解释即可用于战略或战术。'切实可行'是指理解指导规范的人可以视相关情况（包括他或她自己的行为）识别企业是否遵守该指导规范。业务规则是一条受业务政策管辖的规则。规则是一种有义务或必须达成的命题，从常识理解来看，'规则'总是倾向于消除某种程度的自由度。业务规则具有高度结构化的特点，并且使用标准词汇精心表述。业务规则应当是独立且原子化的——即仅表示治理或指导的单一方面。旨在规范、指导或影响业务行为，以支持针对机遇、威胁、优势或劣势所制定的业务政策。业务规则指导业务流程的运行。从形式上讲，业务规则是受业务管辖权约束的规则。约束：高度结构化的、比较具体、原子的、使用标准业务术语谨慎表达。"@zh ;
    rdfs:subClassOf :Directive .

### 11. 操作性业务规则 OperativeBusinessRule
:OperativeBusinessRule rdf:type owl:Class ;
    rdfs:label "操作性业务规则"@zh ;
    rdfs:comment "操作性业务规则具有执行级别，分为严格执行、授权覆盖override、建议等。"@zh ;
    rdfs:subClassOf :BusinessRule .

### 12. 结构性业务规则 StructuralBusinessRule
:StructuralBusinessRule rdf:type owl:Class ;
    rdfs:label "结构性业务规则"@zh ;
    rdfs:comment "没有执行级别的考虑，根据定义即为真实有效。"@zh ;
    rdfs:subClassOf :BusinessRule .

### 13. 影响因素 Influencer
:Influencer rdf:type owl:Class ;
    rdfs:label "影响因素"@zh ;
    rdfs:comment "特指那些能对企业资源配置或目标达成产生实质性影响的要素，影响因素本身是中立的，代表了一个客观事实或潜在变化，其本身并无好坏之分，但企业一旦识别并评估它，就可能引发战略调整。影响因素应始终以中立、客观的事实方式表述。因此，影响因素表述中不应包含任何定性词汇。使用定性词汇意味着对影响因素进行了评估。企业会持续监控可能带来变化的影响因素，并对其中意义重大的信号进行评估。"@zh ;
    rdfs:subClassOf owl:Thing .

### 14. 内部影响因素 InternalInfluencer
:InternalInfluencer rdf:type owl:Class ;
    rdfs:label "内部影响因素"@zh ;
    rdfs:comment "源自企业自身内部，通过提升或改善可施加积极影响的因素。内部影响因素分类：假设、企业价值观、惯例、基础设施、管理层权限、资源等。"@zh ;
    rdfs:subClassOf :Influencer .

:Resource rdf:type owl:Class ;
    rdfs:label "资源"@zh ;
    rdfs:comment "组织拥有的、可用于实现其目标的资产或能力，通常指有形或无形资产（如资金、人员、品牌、IT系统）"@zh ;
    rdfs:subClassOf :InternalInfluencer .

### 14.1 资产 Asset
:Asset rdf:type owl:Class ;
    rdfs:label "资产"@zh ;
    rdfs:comment "企业拥有的一种资源，可用于实现目标或产生价值"@zh ;
    rdfs:subClassOf :Resource .

### 14.2 固定资产 FixedAsset
:FixedAsset rdf:type owl:Class ;
    rdfs:label "固定资产"@zh ;
    rdfs:comment "使用期限超过一个会计期间的资产"@zh ;
    rdfs:subClassOf :Asset .

# ------------------------------------------------------------
# 14.2.x IT 资产家族（2026-09-29 自 EA 迁入；EA 从此只做流程建模）
#   ITAsset 是 Asset（→ Resource）的子类；主系统 / 子系统 / 硬件资产 都是 IT 资产。
#   原 EA 的「应用系统（ea:Application）」即本模块的 SubSystem（子系统）。
# ------------------------------------------------------------

### 14.2.1 IT 资产 ITAsset
:ITAsset rdf:type owl:Class ;
    rdfs:subClassOf :Asset ;
    rdfs:label "IT资产"@zh ;
    rdfs:comment "IT 资产，如软件系统（主系统/子系统）、硬件资产等"@zh .

### 14.2.2 主系统 MainSystem
:MainSystem rdf:type owl:Class ;
    rdfs:subClassOf :ITAsset ;
    rdfs:label "主系统"@zh ;
    rdfs:comment "承载核心业务能力的应用系统（主系统），可包含若干子系统"@zh .

### 14.2.3 子系统 SubSystem
:SubSystem rdf:type owl:Class ;
    rdfs:subClassOf :ITAsset ;
    rdfs:label "子系统"@zh ;
    rdfs:comment "主系统下的子系统（原 EA 的「应用系统 Application」）"@zh .

### 14.2.4 硬件资产 HardwareAsset
:HardwareAsset rdf:type owl:Class ;
    rdfs:subClassOf :ITAsset ;
    rdfs:label "硬件资产"@zh ;
    rdfs:comment "硬件资产（服务器、网络设备、终端等），归属于某个子系统"@zh .

### 14.3 对外交付物 Offering
:Offering rdf:type owl:Class ;
    rdfs:label "对外交付物"@zh ;
    rdfs:comment "一种固定资产，是对企业可提供的产品或服务的规格说明；Offering 的实例（如产成品）是一种资源。Offering 可由行动方案定义、可由业务流程交付、可能需要资源、可能使用固定资产。"@zh ;
    rdfs:subClassOf :FixedAsset .

### 14.4 产品 Product
:Product rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "产品"@zh ;
    rdfs:comment "具体产品，一种可交付的对外交付物"@zh .

### 14.5 即将到期的产品 ExpiringProduct
:ExpiringProduct rdf:type owl:Class ;
    rdfs:subClassOf :Product ;
    rdfs:label "即将到期的产品"@zh ;
    rdfs:comment "即将到期的产品"@zh .

### 14.6 业务服务 BusinessService
:BusinessService rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "业务服务"@zh ;
    rdfs:comment "业务服务（非 IT 服务），一种可交付的对外交付物"@zh .

### 14.7 责任 Liability
:Liability rdf:type owl:Class ;
    rdfs:label "责任"@zh ;
    rdfs:comment "企业所承担的义务或债务（如未偿债务、保修承诺、合同义务）。责任由组织机构负责，可由行动方案免除（清偿），并会占用（索取）企业资源。"@zh ;
    rdfs:subClassOf owl:Thing .

### 15. 外部影响因素 ExternalInfluencer
:ExternalInfluencer rdf:type owl:Class ;
    rdfs:label "外部影响因素"@zh ;
    rdfs:comment "来自企业边界之外、无法直接控制的因素。外部影响因素分类：竞争者、客户、环境、合作伙伴、法规、技术发展等。"@zh ;
    rdfs:subClassOf :Influencer .

### 16. 评估 Assessment
:Assessment rdf:type owl:Class ;
    rdfs:label "评估"@zh ;
    rdfs:comment "评估实质上是判断影响因素对目标的达成和/或手段的采用产生何种影响。评估可以有多种分类方式，SWOT（优势、劣势、机会、威胁）是评估领域常用的分析方法。"@zh ;
    rdfs:subClassOf owl:Thing .

### 17. 业务流程 BusinessProcess
:BusinessProcess rdf:type owl:Class ;
    rdfs:label "业务流程"@zh ;
    rdfs:comment "业务流程是一组在组织内部或跨组织范围内执行的活动。"@zh ;
    rdfs:subClassOf owl:Thing .

### 18. 组织机构 OrganizationUnit
:OrganizationUnit rdf:type owl:Class ;
    rdfs:label "组织机构"@zh ;
    rdfs:comment "一个组织的组成单元"@zh ;
    rdfs:subClassOf owl:Thing .

# ============================================================
# 二、枚举类定义（Enumeration Classes）
# ============================================================

### 24. 执行级别 EnforcementLevel
:EnforcementLevel rdf:type owl:Class ;
    rdfs:label "执行级别"@zh ;
    rdfs:comment "操作性业务规则的执行强度分类"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:oneOf ( :Strict :Override :Advisory :Summary )
    ] .

:Strict rdf:type :EnforcementLevel ;
    rdfs:label "严格执行"@zh ;
    rdfs:comment "必须无条件遵守，不可偏离"@zh .

:Override rdf:type :EnforcementLevel ;
    rdfs:label "授权覆盖"@zh ;
    rdfs:comment "在获得授权的情况下可例外处理"@zh .

:Advisory rdf:type :EnforcementLevel ;
    rdfs:label "建议"@zh ;
    rdfs:comment "推荐遵守，但允许根据情况灵活调整"@zh .

### 25. 评估类型 AssessmentType（严格限定为SWOT四维度）
:AssessmentType rdf:type owl:Class ;
    rdfs:label "评估类型"@zh ;
    rdfs:comment "评估的分类方式，仅限SWOT分析中的四个具体维度：优势、劣势、机会、威胁"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:oneOf ( :Strength :Weakness :Opportunity :Threat )
    ] .

:Strength rdf:type :AssessmentType ;
    rdfs:label "优势"@zh ;
    rdfs:comment "Strengths，指企业内部相较于竞争对手所拥有的有利条件或卓越能力"@en .

:Weakness rdf:type :AssessmentType ;
    rdfs:label "劣势"@zh ;
    rdfs:comment "Weaknesses，指企业内部存在的不利于达成目标的因素或资源短板"@en .

:Opportunity rdf:type :AssessmentType ;
    rdfs:label "机会"@zh ;
    rdfs:comment "Opportunities，指企业外部环境中可以利用的有利趋势或空间"@en .

:Threat rdf:type :AssessmentType ;
    rdfs:label "威胁"@zh ;
    rdfs:comment "Threats，指企业外部环境中可能对企业造成损害的风险或挑战"@en .

# ============================================================
# 三、对象属性（Object Properties）
# ============================================================

### 手段实现预期成果
:realizes rdf:type owl:ObjectProperty ;
    rdfs:label "实现"@zh ;
    rdfs:domain :Means ;
    rdfs:range :DesiredResult ;
    rdfs:comment "一个手段用于实现预期成果"@zh .

### 目标量化目的
:quantifies rdf:type owl:ObjectProperty ;
    rdfs:label "量化"@zh ;
    rdfs:domain :Objective ;
    rdfs:range :Goal ;
    rdfs:comment "一个目标量化了一个目的"@zh .

### 预期成果包含其他预期成果
:containsResult rdf:type owl:ObjectProperty ;
    rdfs:label "包含预期成果"@zh ;
    rdfs:domain :DesiredResult ;
    rdfs:range :DesiredResult ;
    rdfs:comment "一个预期成果可以包含其他预期成果"@zh .

### 管辖关系
:isGovernedBy rdf:type owl:ObjectProperty ;
    rdfs:label "受管辖"@zh ;
    rdfs:domain :CourseOfAction ;
    rdfs:range :Directive ;
    rdfs:comment "一个行动方案受指导规范管辖"@zh .

:governs rdf:type owl:ObjectProperty ;
    rdfs:label "管辖"@zh ;
    rdfs:domain :Directive ;
    rdfs:range :CourseOfAction ;
    rdfs:comment "一个指导规范管辖行动方案"@zh ;
    owl:inverseOf :isGovernedBy .

### 指导规范可能是行动方案的来源
:isSourceOf rdf:type owl:ObjectProperty ;
    rdfs:label "是...的来源"@zh ;
    rdfs:domain :Directive ;
    rdfs:range :CourseOfAction ;
    rdfs:comment "一个指导规范可能是行动方案的来源"@zh .

### 行动方案与业务流程
:realizedBy rdf:type owl:ObjectProperty ;
    rdfs:label "由...实现"@zh ;
    rdfs:domain :CourseOfAction ;
    rdfs:range :BusinessProcess ;
    rdfs:comment "一个行动方案由业务流程实现"@zh .

:realizesProcess rdf:type owl:ObjectProperty ;
    rdfs:label "实现行动方案"@zh ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :CourseOfAction ;
    owl:inverseOf :realizedBy .

### 行动方案的其他关系
:definesOffering rdf:type owl:ObjectProperty ;
    rdfs:label "定义交付物"@zh ;
    rdfs:domain :CourseOfAction ;
    rdfs:range :Offering ;
    rdfs:comment "一个行动方案可以定义对外交付物（产品或服务）"@zh .

:deploysAsset rdf:type owl:ObjectProperty ;
    rdfs:label "部署资产"@zh ;
    rdfs:domain :CourseOfAction ;
    rdfs:range :Resource ;
    rdfs:comment "一个行动方案可以部署资产"@zh .

### 对外交付物（Offering）的关系
:deliversOffering rdf:type owl:ObjectProperty ;
    rdfs:label "交付"@zh ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :Offering ;
    rdfs:comment "一个业务流程可以交付对外交付物"@zh .

:requiresResource rdf:type owl:ObjectProperty ;
    rdfs:label "需要资源"@zh ;
    rdfs:domain :Offering ;
    rdfs:range :Resource ;
    rdfs:comment "一个对外交付物可能需要资源"@zh .

:usesFixedAsset rdf:type owl:ObjectProperty ;
    rdfs:label "使用固定资产"@zh ;
    rdfs:domain :Offering ;
    rdfs:range :FixedAsset ;
    rdfs:comment "一个对外交付物可能使用固定资产"@zh .

:dischargesLiability rdf:type owl:ObjectProperty ;
    rdfs:label "免除责任"@zh ;
    rdfs:domain :CourseOfAction ;
    rdfs:range :Liability ;
    rdfs:comment "一个行动方案可以免除（清偿）某个责任"@zh .

### 责任（Liability）的其他关系
:managesLiability rdf:type owl:ObjectProperty ;
    rdfs:label "负责"@zh ;
    rdfs:domain :OrganizationUnit ;
    rdfs:range :Liability ;
    rdfs:comment "一个组织机构对某个责任负责（承担管理职责）"@zh .

:claimsResource rdf:type owl:ObjectProperty ;
    rdfs:label "占用资源"@zh ;
    rdfs:domain :Liability ;
    rdfs:range :Resource ;
    rdfs:comment "一个责任占用（索取）企业资源，如债务需要资金清偿"@zh .

:enables rdf:type owl:ObjectProperty ;
    rdfs:label "启用"@zh ;
    rdfs:domain :CourseOfAction ;
    rdfs:range :CourseOfAction ;
    rdfs:comment "一个行动方案可以启用其他行动方案"@zh .

:includes rdf:type owl:ObjectProperty ;
    rdfs:label "包含行动方案"@zh ;
    rdfs:domain :CourseOfAction ;
    rdfs:range :CourseOfAction ;
    rdfs:comment "一个行动方案可以包含其他行动方案"@zh .

### 业务政策与业务规则
:isBasisFor rdf:type owl:ObjectProperty ;
    rdfs:label "是...的基础"@zh ;
    rdfs:domain :BusinessPolicy ;
    rdfs:range :BusinessRule ;
    rdfs:comment "业务政策是业务规则的基础"@zh .

:isDerivedFrom rdf:type owl:ObjectProperty ;
    rdfs:label "源自"@zh ;
    rdfs:domain :BusinessRule ;
    rdfs:range :BusinessPolicy ;
    rdfs:comment "一个业务规则源自业务政策"@zh ;
    owl:inverseOf :isBasisFor .

### 指导和管理业务流程
:guides rdf:type owl:ObjectProperty ;
    rdfs:label "指导"@zh ;
    rdfs:domain :BusinessRule ;
    rdfs:range :BusinessProcess ;
    rdfs:comment "一个业务规则可以指导业务流程"@zh .

:manages rdf:type owl:ObjectProperty ;
    rdfs:label "管理"@zh ;
    rdfs:domain :BusinessPolicy ;
    rdfs:range :BusinessProcess ;
    rdfs:comment "业务政策可以管理业务流程"@zh .

### 影响关系
:influences rdf:type owl:ObjectProperty ;
    rdfs:label "影响预期成果"@zh ;
    rdfs:domain :Influencer ;
    rdfs:range :DesiredResult ;
    rdfs:comment "一个预期成果可能受到影响因素的影响，具体体现在评价体系中"@zh .

:influencesMeans rdf:type owl:ObjectProperty ;
    rdfs:label "影响手段"@zh ;
    rdfs:domain :Influencer ;
    rdfs:range :Means ;
    rdfs:comment "一个手段可能受到影响因素的影响，具体体现在评估中"@zh .

### 评估关系
:assesses rdf:type owl:ObjectProperty ;
    rdfs:label "评估影响因素"@zh ;
    rdfs:domain :Assessment ;
    rdfs:range :Influencer ;
    rdfs:comment "一项评估阐明了影响因素与目标和/或手段之间的逻辑联系，是对影响因素的判断"@zh .

:assessesDesiredResult rdf:type owl:ObjectProperty ;
    rdfs:label "评估预期成果"@zh ;
    rdfs:domain :Assessment ;
    rdfs:range :DesiredResult ;
    rdfs:comment "评估阐明影响因素对目标的影响"@zh .

:assessesMeans rdf:type owl:ObjectProperty ;
    rdfs:label "评估手段"@zh ;
    rdfs:domain :Assessment ;
    rdfs:range :Means ;
    rdfs:comment "评估阐明影响因素对手段的影响"@zh .

:promotesDirective rdf:type owl:ObjectProperty ;
    rdfs:label "促进指导规范"@zh ;
    rdfs:domain :Assessment ;
    rdfs:range :Directive ;
    rdfs:comment "一项评估可以促进指导规范的执行"@zh .

### 组织机构关联
:definedBy rdf:type owl:ObjectProperty ;
    rdfs:label "由...定义"@zh ;
    rdfs:domain :DesiredResult ;
    rdfs:range :OrganizationUnit ;
    rdfs:comment "一个预期成果必须由至少一个组织机构定义"@zh .

:createdBy rdf:type owl:ObjectProperty ;
    rdfs:label "由...创建"@zh ;
    rdfs:domain :Means ;
    rdfs:range :OrganizationUnit ;
    rdfs:comment "一个手段由组织机构创建"@zh .

:assessedBy rdf:type owl:ObjectProperty ;
    rdfs:label "由...完成评估"@zh ;
    rdfs:domain :Assessment ;
    rdfs:range :OrganizationUnit ;
    rdfs:comment "一项评估必须由至少一个组织单位完成"@zh .


### 枚举属性（执行级别、评估类型）
:hasEnforcementLevel rdf:type owl:ObjectProperty ;
    rdfs:label "具有执行级别"@zh ;
    rdfs:domain :OperativeBusinessRule ;
    rdfs:range :EnforcementLevel ;
    rdfs:comment "操作性业务规则具有的执行级别，取值来自枚举类 EnforcementLevel"@zh .

:hasAssessmentType rdf:type owl:ObjectProperty ;
    rdfs:label "具有评估类型"@zh ;
    rdfs:domain :Assessment ;
    rdfs:range :AssessmentType ;
    rdfs:comment "评估属于哪一种SWOT维度（优势、劣势、机会、威胁）"@zh .


### IT 资产 / 系统关系（2026-09-29 新增）
:mainSystemContainsSubSystem rdf:type owl:ObjectProperty ;
    rdfs:label "包含子系统"@zh ;
    rdfs:domain :MainSystem ;
    rdfs:range :SubSystem ;
    rdfs:comment "主系统包含子系统（一个主系统可包含多个子系统）"@zh .

:hardwareAssetBelongsToSubSystem rdf:type owl:ObjectProperty ;
    rdfs:label "归属于子系统"@zh ;
    rdfs:domain :HardwareAsset ;
    rdfs:range :SubSystem ;
    rdfs:comment "硬件资产归属于某个子系统"@zh .

:mainSystemBelongsToOrganizationUnit rdf:type owl:ObjectProperty ;
    rdfs:label "归属业务部门"@zh ;
    rdfs:domain :MainSystem ;
    rdfs:range :OrganizationUnit ;
    rdfs:comment "主系统归属（由哪个）业务部门负责"@zh .

:subSystemBelongsToOrganizationUnit rdf:type owl:ObjectProperty ;
    rdfs:label "归属业务部门"@zh ;
    rdfs:domain :SubSystem ;
    rdfs:range :OrganizationUnit ;
    rdfs:comment "子系统归属（由哪个）业务部门负责"@zh .

# ============================================================
# 四、数据属性（Datatype Properties）
# ============================================================

:name rdf:type owl:DatatypeProperty ;
    rdfs:label "名称"@zh ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

:englishName rdf:type owl:DatatypeProperty ;
    rdfs:label "英文名称"@zh ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

:definition rdf:type owl:DatatypeProperty ;
    rdfs:label "定义"@zh ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

:description rdf:type owl:DatatypeProperty ;
    rdfs:label "描述"@zh ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

:CourseOfActionlevel rdf:type owl:DatatypeProperty ;
    rdfs:label "级别"@zh ;
    rdfs:domain :CourseOfAction ;
    rdfs:range xsd:string ;
    rdfs:comment "行动方案级别，如'战略级'或'战术级'" .

:influencerCategory rdf:type owl:DatatypeProperty ;
    rdfs:label "影响因素分类"@zh ;
    rdfs:domain :Influencer ;
    rdfs:range xsd:string ;
    rdfs:comment "内部或外部影响因素的具体分类，如'假设'、'竞争者'等" .


### IT 资产 / 系统属性（2026-09-29 新增；「英文名称」「描述/功能简介」复用本文件的 englishName / description）
:systemNo rdf:type owl:DatatypeProperty ;
    rdfs:label "系统编号"@zh ;
    rdfs:domain :ITAsset ;
    rdfs:range xsd:string ;
    rdfs:comment "系统的内部编号（主系统/子系统通用，台账主键）" .

:systemAbbr rdf:type owl:DatatypeProperty ;
    rdfs:label "英文简称"@zh ;
    rdfs:domain :ITAsset ;
    rdfs:range xsd:string ;
    rdfs:comment "系统的英文简称（主系统/子系统通用）" .

:systemCriticality rdf:type owl:DatatypeProperty ;
    rdfs:label "重要性等级"@zh ;
    rdfs:domain :ITAsset ;
    rdfs:range xsd:string ;
    rdfs:comment "系统重要性等级（主系统/子系统通用），如'高'/'中'/'低'" .

:systemStatus rdf:type owl:DatatypeProperty ;
    rdfs:label "状态"@zh ;
    rdfs:domain :ITAsset ;
    rdfs:range xsd:string ;
    rdfs:comment "系统状态（主系统/子系统通用），如'在用'/'在建'/'下线'" .

:coreFunction rdf:type owl:DatatypeProperty ;
    rdfs:label "核心功能"@zh ;
    rdfs:domain :SubSystem ;
    rdfs:range xsd:string ;
    rdfs:comment "子系统的核心功能说明" .

:hardwareAssetCategory rdf:type owl:DatatypeProperty ;
    rdfs:label "硬件资产分类"@zh ;
    rdfs:domain :HardwareAsset ;
    rdfs:range xsd:string ;
    rdfs:comment "硬件资产分类，如'服务器'/'网络设备'/'终端'/'存储'" .

### 业务规则属性（2026-09-29 新增；用于结构化批量建模：规则表的「适用范围/实现方式/参考规范细则」）
:ruleScope rdf:type owl:DatatypeProperty ;
    rdfs:label "适用范围"@zh ;
    rdfs:domain :OperativeBusinessRule ;
    rdfs:range xsd:string ;
    rdfs:comment "规则适用的范围/场景，如'技术方案/总体方案/应用架构'" .

:ruleImplementation rdf:type owl:DatatypeProperty ;
    rdfs:label "实现方式"@zh ;
    rdfs:domain :OperativeBusinessRule ;
    rdfs:range xsd:string ;
    rdfs:comment "规则的落地方式，如'LLM软规则'/'图谱检索'/'人工检查'" .

:ruleReference rdf:type owl:DatatypeProperty ;
    rdfs:label "参考规范细则"@zh ;
    rdfs:domain :OperativeBusinessRule ;
    rdfs:range xsd:string ;
    rdfs:comment "规则出处/参考规范的链接或文档标题（逐字原文请写进正文「## 原文依据」）" .


# ============================================================
# 五、基数约束（Cardinality Restrictions）
# ============================================================

:DesiredResult rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :definedBy ;
    owl:minCardinality 1 ;
    rdfs:comment "预期成果必须由至少一个组织机构定义"
] .

:Assessment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :assessedBy ;
    owl:minCardinality 1 ;
    rdfs:comment "评估必须由至少一个组织单位完成"
] .


:OperativeBusinessRule rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasEnforcementLevel ;
    owl:cardinality 1 ;
    rdfs:comment "操作性业务规则必须且只能有一个执行级别"
] .

:Assessment rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :hasAssessmentType ;
    owl:cardinality 1 ;
    rdfs:comment "每一项评估必须且只能属于优势、劣势、机会、威胁中的一种"
] .

# ============================================================
# 六、知识来源：会话知识页（2026-10-01 新增 · 第一闭环）
#   口径（用户）：知识的产生与变化都发生在与智能体的会话里 → 会话即来源；
#   会话在系统里虽有保存，但被删就断链 → 必须作为知识入库（页面 + 本体个体）。
# ============================================================

### 31. 知识会话 KnowledgeSession
:KnowledgeSession rdf:type owl:Class ;
    rdfs:label "知识会话"@zh ;
    rdfs:comment "与智能体的一次会话，是知识产生与变化的统一来源。会话起始页只保存基本信息（会话编号/名称/智能体名称/租户名称/初始问题/开始时间/权威库）；上下文过长且一组高相关知识已确认更新完成时可新开分页，各分页共享同一会话编号与名称；会话分页与其产出的知识必须在同一个知识库；跨库时会话起始页每库各一份副本，以初始库为权威。"@zh ;
    rdfs:subClassOf owl:Thing .

### 32. 会话状态 SessionStatus
:SessionStatus rdf:type owl:Class ;
    rdfs:label "会话状态"@zh ;
    rdfs:comment "会话分页的处置状态（存档只改状态、不删页，保留溯源链）"@zh ;
    owl:equivalentClass [
        rdf:type owl:Class ;
        owl:oneOf ( :SessionActive :SessionArchived )
    ] .

:SessionActive rdf:type :SessionStatus ;
    rdfs:label "进行中"@zh ;
    rdfs:comment "会话仍有未过期、未废弃的知识"@zh .

:SessionArchived rdf:type :SessionStatus ;
    rdfs:label "已存档"@zh ;
    rdfs:comment "该会话各页关联的知识均已过期或废弃 → 可存档"@zh .

### 33. 会话属性（起始页基本信息）与溯源定位
:sessionNo rdf:type owl:DatatypeProperty ;
    rdfs:label "会话编号"@zh ;
    rdfs:domain :KnowledgeSession ;
    rdfs:range xsd:string ;
    rdfs:comment "会话唯一编号，如 'S-20261001-01'；同一会话的各分页共享同一编号" .

:sessionName rdf:type owl:DatatypeProperty ;
    rdfs:label "会话名称"@zh ;
    rdfs:domain :KnowledgeSession ;
    rdfs:range xsd:string .

:agentName rdf:type owl:DatatypeProperty ;
    rdfs:label "智能体名称"@zh ;
    rdfs:domain :KnowledgeSession ;
    rdfs:range xsd:string .

:tenantName rdf:type owl:DatatypeProperty ;
    rdfs:label "租户名称"@zh ;
    rdfs:domain :KnowledgeSession ;
    rdfs:range xsd:string .

:initialQuestion rdf:type owl:DatatypeProperty ;
    rdfs:label "初始问题"@zh ;
    rdfs:domain :KnowledgeSession ;
    rdfs:range xsd:string ;
    rdfs:comment "会话起始页只保存基本信息（会话编号/名称/智能体名称/租户名称/初始问题/开始时间）" .

:startedAt rdf:type owl:DatatypeProperty ;
    rdfs:label "开始时间"@zh ;
    rdfs:domain :KnowledgeSession ;
    rdfs:range xsd:string .

:partNo rdf:type owl:DatatypeProperty ;
    rdfs:label "分页序号"@zh ;
    rdfs:domain :KnowledgeSession ;
    rdfs:range xsd:string ;
    rdfs:comment "上下文过长且一组高相关知识已确认更新完成时新开分页；分页关联同一会话编号与名称" .

:isAuthoritative rdf:type owl:DatatypeProperty ;
    rdfs:label "是否权威副本"@zh ;
    rdfs:domain :KnowledgeSession ;
    rdfs:range xsd:boolean ;
    rdfs:comment "跨库时会话起始页每库各一份：true=权威副本（初始库），false=副本（应指向权威页）" .

:sessionStatus rdf:type owl:ObjectProperty ;
    rdfs:label "会话状态"@zh ;
    rdfs:domain :KnowledgeSession ;
    rdfs:range :SessionStatus ;
    rdfs:comment "会话当前状态，取值来自枚举类 SessionStatus"@zh .

:sourceSession rdf:type owl:ObjectProperty ;
    rdfs:label "知识来源会话"@zh ;
    rdfs:domain owl:Thing ;
    rdfs:range :KnowledgeSession ;
    rdfs:comment "任何知识页/知识项都应能指回其来源会话（来源都指向会话知识页的相关上下文）"@zh .

:sourceLocator rdf:type owl:DatatypeProperty ;
    rdfs:label "来源定位"@zh ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:comment "会话内定位：分页序号 + 轮次/消息/段落（或图坐标），用于可复核" .

:sessionFor rdf:type owl:ObjectProperty ;
    rdfs:label "服务方案"@zh ;
    rdfs:domain :KnowledgeSession ;
    rdfs:range :CourseOfAction ;
    rdfs:comment "该会话服务于哪个行动方案/需求/项目（弱桥，可选）"@zh .

### 34. 规则元数据：判定所需知识（2026-10-01 新增）
:knowledgeNeed rdf:type owl:DatatypeProperty ;
    rdfs:label "判定所需知识"@zh ;
    rdfs:domain :OperativeBusinessRule ;
    rdfs:range xsd:string ;
    rdfs:comment "判定该规则前必须先提取的知识项（需求『按规则需要的知识内容提取』的落点；也是抽取技能的输入契约）"@zh .


# 模块短名（目录名/列表名；≤16 字符，导入时校验）
<http://example.org/bmm> bodhi:shortName "BMM业务动机模型" .
