@prefix :       <http://example.org/bodhi/ext/bmm-fd#> .
@prefix bmm:    <http://example.org/bmm#> .
@prefix ea:     <http://example.org/bmm-EA-ext#> .
@prefix easvc:  <http://example.org/bodhi/ext/ea-service#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/bodhi/ext/bmm-fd> rdf:type owl:Ontology ;
    rdfs:label "BMM 规则可执行化扩展本体（数据质量规则 / 访问控制规则）"@zh ;
    rdfs:comment "把 BMM 的指导规范落到可执行、可校验的形态：结构性与操作性业务规则细分为『数据质量规则』与『访问控制规则』，并提供规则->实体/属性/契约的跨层引用关系，使 BMM 规则可以被执行层网关与校验器直接消费。"@zh ;
    owl:imports <http://example.org/bmm> , <http://example.org/bmm-EA-ext> , <http://example.org/bodhi/ext/ea-service> ;
    owl:versionIRI <http://example.org/bodhi/ext/bmm-fd/1.0> .

# ============================================================
# 一、类定义
# ============================================================

### 数据质量规则：按定义恒真的结构性规则，可编译为数据校验
:DataQualityRule rdf:type owl:Class ;
    rdfs:label "数据质量规则"@zh ;
    rdfs:comment "对业务实体/属性的恒真约束（唯一性、非空、值域、函数依赖），可由编译器直接翻译为数据校验（SHACL / SQL / Cypher）。继承结构性业务规则：无需执行级别。"@zh ;
    rdfs:subClassOf bmm:StructuralBusinessRule .

### 访问控制规则：需要强制执行的操作性规则
:AccessControlRule rdf:type owl:Class ;
    rdfs:label "访问控制规则"@zh ;
    rdfs:comment "约束『谁可以在什么条件下对哪个实体执行哪个服务』的操作性规则，必须有执行级别（继承自操作性业务规则：hasEnforcementLevel 恰好 1 个）。"@zh ;
    rdfs:subClassOf bmm:OperativeBusinessRule .

# ============================================================
# 二、对象属性（跨层引用：BMM 规则 -> EA 实体/属性/契约）
# ============================================================

:ruleConstrainsEntity rdf:type owl:ObjectProperty ;
    rdfs:label "约束业务实体"@zh ;
    rdfs:domain bmm:BusinessRule ;
    rdfs:range ea:BusinessEntity ;
    rdfs:comment "该规则约束哪个业务实体（跨层桥：指导规范 -> EA 业务实体）。"@zh .

:ruleConstrainsAttribute rdf:type owl:ObjectProperty ;
    rdfs:label "约束业务属性"@zh ;
    rdfs:domain bmm:BusinessRule ;
    rdfs:range easvc:BusinessAttribute ;
    rdfs:comment "该规则约束哪个业务属性（跨层桥：指导规范 -> 业务属性，用于生成字段级校验）。"@zh .

:ruleEnforcedByContract rdf:type owl:ObjectProperty ;
    rdfs:label "由契约强制"@zh ;
    rdfs:domain bmm:BusinessRule ;
    rdfs:range easvc:ServiceContract ;
    rdfs:comment "该规则由哪个服务契约在执行层面强制（跨层桥：规则 -> 可执行契约）。"@zh .

# ============================================================
# 三、数据属性
# ============================================================

:ruleExpression rdf:type owl:DatatypeProperty ;
    rdfs:label "规则表达式"@zh ;
    rdfs:domain bmm:BusinessRule ;
    rdfs:range xsd:string ;
    rdfs:comment "规则的可执行表达（如伪代码、Cypher、SHACL-SPARQL 片段），由编译器进一步翻译为目标技术栈实现。"@zh .

:ruleSeverity rdf:type owl:DatatypeProperty ;
    rdfs:label "规则严重级别"@zh ;
    rdfs:domain bmm:BusinessRule ;
    rdfs:range xsd:string ;
    rdfs:comment "违反规则的严重级别取值建议：error（阻断） / warning（告警） / info（提示）。"@zh .

# ============================================================
# 四、公理约束（TBox）
# ============================================================

# 数据质量规则必须给出可执行表达式
:DataQualityRule rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :ruleExpression ;
    owl:minCardinality 1 ;
    rdfs:comment "数据质量规则必须给出至少一个可执行表达式，否则无法翻译为校验"@zh
] .

# 访问控制规则必须声明严重级别
:AccessControlRule rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :ruleSeverity ;
    owl:cardinality 1 ;
    rdfs:comment "访问控制规则必须且只能声明一个严重级别"@zh
] .
