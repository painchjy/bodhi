@prefix :       <http://example.org/bmm-ext#> .
@prefix bmm:    <http://example.org/bmm#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# 1. 声明外部 BMM 概念（实际使用时请导入标准 BMM 本体）
# ============================================================
bmm:Ends                a owl:Class ;
    rdfs:comment "BMM Ends（目的）的抽象类" .

bmm:DesiredResult       a owl:Class ;
    rdfs:subClassOf bmm:Ends ;
    rdfs:label "预期成果"@zh ;
    rdfs:comment "预期成果，是 End 的细化，例如 Goal、Objective" .

bmm:Means               a owl:Class ;
    rdfs:comment "BMM Means（手段）的抽象类" .

bmm:CourseOfAction      a owl:Class ;
    rdfs:subClassOf bmm:Means ;
    rdfs:label "行动方案"@zh ;
    rdfs:comment "行动方案，是 Means 的细化，例如 Strategy、Tactic" .

bmm:BusinessRule        a owl:Class ;
    rdfs:subClassOf bmm:Means ;
    rdfs:label "业务规则"@zh .

bmm:Resource            a owl:Class ;
    rdfs:label "资源"@zh .

bmm:Influencer          a owl:Class ;
    rdfs:label "影响因素"@zh .

bmm:Resource            rdfs:subClassOf bmm:Influencer .

# ============================================================
# 2. 业务层核心类
# ============================================================
:BusinessProcess    a owl:Class ;
    rdfs:subClassOf bmm:CourseOfAction ;    # 业务流程是一种行动方案
    rdfs:label "业务流程"@zh ;
    rdfs:comment "业务流程，编排活动以实现特定业务目标" .

:Activity           a owl:Class ;
    rdfs:label "活动"@zh ;
    rdfs:comment "活动，对任务的编排，完成业务上特定的目标" .

:Task               a owl:Class ;
    rdfs:label "任务"@zh ;
    rdfs:comment "任务，某个岗位或角色连续执行的操作" .

:Step               a owl:Class ;
    rdfs:label "步骤"@zh ;
    rdfs:comment "步骤，对单个或一组紧耦合业务实体的操作" .

:BusinessRole       a owl:Class ;
    rdfs:label "业务角色"@zh ;
    rdfs:comment "业务角色或岗位" .

:BusinessEntity     a owl:Class ;
    rdfs:label "业务实体"@zh ;
    rdfs:comment "业务实体，如客户、合同、账户、申请单等" .

:Offering           a owl:Class ;
    rdfs:label "对外交付物"@zh ;
    rdfs:comment "对外提供的产品或业务服务的统称" .

:Product            a owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "产品"@zh ;
    rdfs:comment "具体产品" .

:BusinessService    a owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "业务服务"@zh ;
    rdfs:comment "业务服务（非 IT 服务）" .

# ============================================================
# 3. IT 资产与 IT 服务
# ============================================================
:ITAsset            a owl:Class ;
    rdfs:subClassOf bmm:Resource ;          # IT 资产是 BMM 资源的子类
    rdfs:label "IT资产"@zh ;
    rdfs:comment "IT 资产，如硬件、软件系统等" .

:Application        a owl:Class ;
    rdfs:subClassOf :ITAsset ;
    rdfs:label "应用系统"@zh ;
    rdfs:comment "应用（或称为子系统），软件资产" .

:HardwareAsset      a owl:Class ;
    rdfs:subClassOf :ITAsset ;
    rdfs:label "硬件资产"@zh ;
    rdfs:comment "硬件资产" .

:Service            a owl:Class ;
    rdfs:label "IT服务"@zh ;
    rdfs:comment "IT 服务（或称为功能），由应用提供，用于实现步骤" .

# ============================================================
# 4. 关系属性
# ============================================================

# --- 流程组成关系 ---
:businessProcessHasActivity   a owl:ObjectProperty ;
    rdfs:domain :BusinessProcess ;
    rdfs:range :Activity ;
    rdfs:label "包含活动"@zh ;
    rdfs:comment "业务流程包含活动" .

:activityHasTask              a owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Task ;
    rdfs:label "包含任务"@zh ;
    rdfs:comment "活动包含任务" .

:taskHasStep                  a owl:ObjectProperty ;
    rdfs:domain :Task ;
    rdfs:range :Step ;
    rdfs:label "包含步骤"@zh ;
    rdfs:comment "任务包含步骤" .

# --- 执行与操作关系 ---
:taskPerformedByRole          a owl:ObjectProperty ;
    rdfs:domain :Task ;
    rdfs:range :BusinessRole ;
    rdfs:label "由角色执行"@zh ;
    rdfs:comment "任务由业务角色执行" .

:stepOperatesOnEntity         a owl:ObjectProperty ;
    rdfs:domain :Step ;
    rdfs:range :BusinessEntity ;
    rdfs:label "操作业务实体"@zh ;
    rdfs:comment "步骤操作业务实体" .

# --- 规则约束 ---
:taskGovernedByRule           a owl:ObjectProperty ;
    rdfs:domain :Task ;
    rdfs:range bmm:BusinessRule ;
    rdfs:label "受规则约束"@zh ;
    rdfs:comment "任务受业务规则约束" .

# --- IT 资源支撑 ---
:stepSupportedByAsset         a owl:ObjectProperty ;
    rdfs:domain :Step ;
    rdfs:range :ITAsset ;
    rdfs:label "由IT资产支撑"@zh ;
    rdfs:comment "步骤由 IT 资产支撑" .

:applicationProvidesService   a owl:ObjectProperty ;
    rdfs:domain :Application ;
    rdfs:range :Service ;
    rdfs:label "提供服务"@zh ;
    rdfs:comment "应用提供服务/功能" .

:stepUsesService              a owl:ObjectProperty ;
    rdfs:domain :Step ;
    rdfs:range :Service ;
    rdfs:label "使用IT服务"@zh ;
    rdfs:comment "步骤使用 IT 服务实现" .

# --- 目标与交付 ---
:activityDelivers             a owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range :Offering ;
    rdfs:label "交付"@zh ;
    rdfs:comment "活动交付某个产品或业务服务" .

:taskDelivers                 a owl:ObjectProperty ;
    rdfs:domain :Task ;
    rdfs:range :Offering ;
    rdfs:label "交付"@zh ;
    rdfs:comment "任务交付某个产品或业务服务" .

:activityAchievesDesiredResult   a owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range bmm:DesiredResult ;
    rdfs:label "实现预期成果"@zh ;
    rdfs:comment "活动实现某个预期成果" .

:activityRealizesActionPlan   a owl:ObjectProperty ;
    rdfs:domain :Activity ;
    rdfs:range bmm:CourseOfAction ;
    rdfs:label "实现行动方案"@zh ;
    rdfs:comment "活动实现某个行动方案" .

:businessProcessRealizesActionPlan a owl:ObjectProperty ;
    rdfs:domain :BusinessProcess ;
    rdfs:range bmm:CourseOfAction ;
    rdfs:label "实现行动方案"@zh ;
    rdfs:comment "业务流程实现某个行动方案" .

# ============================================================
# 5. 公理约束（TBox）
# ============================================================

# 业务流程至少包含一个活动
:BusinessProcess rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :businessProcessHasActivity ;
    owl:someValuesFrom :Activity
] .

# 活动至少包含一个任务
:Activity rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :activityHasTask ;
    owl:someValuesFrom :Task
] .

# 任务至少包含一个步骤
:Task rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :taskHasStep ;
    owl:someValuesFrom :Step
] .

# 任务必须由至少一个角色执行
:Task rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :taskPerformedByRole ;
    owl:someValuesFrom :BusinessRole
] .

# 步骤必须至少操作一个业务实体
:Step rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :stepOperatesOnEntity ;
    owl:someValuesFrom :BusinessEntity
] .

# 步骤必须至少由一个 IT 资产支撑
:Step rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :stepSupportedByAsset ;
    owl:someValuesFrom :ITAsset
] .

# 步骤必须使用至少一个 IT 服务
:Step rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :stepUsesService ;
    owl:someValuesFrom :Service
] .

# 任务必须至少受一条业务规则约束
:Task rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :taskGovernedByRule ;
    owl:someValuesFrom bmm:BusinessRule
] .

# 每个应用至少提供一个服务
:Application rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :applicationProvidesService ;
    owl:someValuesFrom :Service
] .

# 活动必须交付至少一个产品或业务服务
:Activity rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :activityDelivers ;
    owl:someValuesFrom :Offering
] .

# 任务必须交付至少一个产品或业务服务
:Task rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :taskDelivers ;
    owl:someValuesFrom :Offering
] .

# 活动必须实现至少一个预期成果
:Activity rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :activityAchievesDesiredResult ;
    owl:someValuesFrom bmm:DesiredResult
] .

# 活动必须实现至少一个行动方案
:Activity rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :activityRealizesActionPlan ;
    owl:someValuesFrom bmm:CourseOfAction
] .

# 业务流程必须实现至少一个行动方案
:BusinessProcess rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :businessProcessRealizesActionPlan ;
    owl:someValuesFrom bmm:CourseOfAction
] .

# ============================================================
# 6. 说明注释
# ============================================================
# 本扩展模型在 BMM 四大支柱基础上：
#   - 将业务流程（BusinessProcess）视为 BMM 行动方案（CourseOfAction）的一种，
#     活动、任务、步骤作为其组成部分；
#   - IT 资产（ITAsset）是 BMM 资源（Resource）的子类，
#     应用（Application）提供 IT 服务，步骤通过 IT 服务实现；
#   - 活动/任务必须交付具体产品或业务服务；
#   - 活动必须实现预期成果（DesiredResult）和行动方案（CourseOfAction）；
#   - 业务流程必须实现行动方案（CourseOfAction）。
#
# 实际使用时，请将 bmm: 命名空间指向标准 BMM 本体 URI，
# 并确保与已有的 BMM 实例数据整合。