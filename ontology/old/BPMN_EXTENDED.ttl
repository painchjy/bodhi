@prefix : <http://example.org/bpmn#> .
@prefix bmm: <http://example.org/bmm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/bpmn> rdf:type owl:Ontology ;
    rdfs:label "简化BPMN本体（与BMM扩展本体协同）"@zh ;
    owl:imports <http://example.org/bmm> ;
    owl:versionIRI <http://example.org/bpmn/1.0> .

# ============================================================
# 一、类定义（Class Definitions）
# ============================================================

### 1. 流节点（Flow Node）—— 顺序流可连接的所有元素的抽象超类
:FlowNode rdf:type owl:Class ;
    rdfs:label "流节点"@zh ;
    rdfs:comment "可被顺序流连接的所有BPMN元素的抽象超类，包括事件、活动、网关"@zh ;
    owl:equivalentClass [
        owl:unionOf (:Event :Activity :Gateway)
    ] .

### 2. 事件（Event）
:Event rdf:type owl:Class ;
    rdfs:label "事件"@zh ;
    rdfs:comment "流程中发生的某种事情，用于标记流程的边界或中间状态"@zh ;
    rdfs:subClassOf :FlowNode .

### 3. 开始事件（Start Event）
:StartEvent rdf:type owl:Class ;
    rdfs:label "开始事件"@zh ;
    rdfs:comment "流程的起点，触发流程实例化。可附带触发器（如消息、定时器）"@zh ;
    rdfs:subClassOf :Event .

### 4. 结束事件（End Event）
:EndEvent rdf:type owl:Class ;
    rdfs:label "结束事件"@zh ;
    rdfs:comment "流程的终点，表示流程实例的终止。可附带结果（如消息抛出、错误终止）"@zh ;
    rdfs:subClassOf :Event .

### 5. 中间事件（Intermediate Event）
:IntermediateEvent rdf:type owl:Class ;
    rdfs:label "中间事件"@zh ;
    rdfs:comment "发生在流程中间的事件，可用于捕获或抛出消息、错误、信号等"@zh ;
    rdfs:subClassOf :Event .

### 6. 活动（Activity）—— 核心执行单元
:Activity rdf:type owl:Class ;
    rdfs:label "活动"@zh ;
    rdfs:comment "流程中执行的工作单元，可以是原子任务或复合活动（此处不细分复合活动）"@zh ;
    rdfs:subClassOf :FlowNode .

### 7. 任务（Task）—— 原子活动
:Task rdf:type owl:Class ;
    rdfs:label "任务"@zh ;
    rdfs:comment "原子级活动，不可再拆分"@zh ;
    rdfs:subClassOf :Activity .

### 8. 任务类型（直接继承Task）
:ServiceTask rdf:type owl:Class ;
    rdfs:label "服务任务"@zh ;
    rdfs:comment "调用外部服务（如Web服务、自动化脚本）"@zh ;
    rdfs:subClassOf :Task .

:UserTask rdf:type owl:Class ;
    rdfs:label "用户任务"@zh ;
    rdfs:comment "由人工参与执行的任务"@zh ;
    rdfs:subClassOf :Task .

:ScriptTask rdf:type owl:Class ;
    rdfs:label "脚本任务"@zh ;
    rdfs:comment "执行一段脚本代码"@zh ;
    rdfs:subClassOf :Task .

:BusinessRuleTask rdf:type owl:Class ;
    rdfs:label "业务规则任务"@zh ;
    rdfs:comment "执行业务规则引擎，该任务可关联 bmm:BusinessRule"@zh ;
    rdfs:subClassOf :Task .

:SendTask rdf:type owl:Class ;
    rdfs:label "发送任务"@zh ;
    rdfs:comment "向外发送消息"@zh ;
    rdfs:subClassOf :Task .

:ReceiveTask rdf:type owl:Class ;
    rdfs:label "接收任务"@zh ;
    rdfs:comment "等待并接收外部消息"@zh ;
    rdfs:subClassOf :Task .

### 9. 网关（Gateway）—— 控制分支与合并
:Gateway rdf:type owl:Class ;
    rdfs:label "网关"@zh ;
    rdfs:comment "控制流程分支、汇合与决策"@zh ;
    rdfs:subClassOf :FlowNode .

:ExclusiveGateway rdf:type owl:Class ;
    rdfs:label "排他网关"@zh ;
    rdfs:comment "根据条件选择唯一分支"@zh ;
    rdfs:subClassOf :Gateway .

:ParallelGateway rdf:type owl:Class ;
    rdfs:label "并行网关"@zh ;
    rdfs:comment "所有分支并行执行"@zh ;
    rdfs:subClassOf :Gateway .

:InclusiveGateway rdf:type owl:Class ;
    rdfs:label "包容网关"@zh ;
    rdfs:comment "根据条件选择多个分支并行执行"@zh ;
    rdfs:subClassOf :Gateway .

### 10. 顺序流（Sequence Flow）
:SequenceFlow rdf:type owl:Class ;
    rdfs:label "顺序流"@zh ;
    rdfs:comment "定义两个流节点之间的执行顺序"@zh ;
    rdfs:subClassOf owl:Thing .

### 11. 数据实体（Data Entity）—— 替代细粒度的数据对象
:DataEntity rdf:type owl:Class ;
    rdfs:label "数据实体"@zh ;
    rdfs:comment "流程中使用的数据结构，包含数据属性（字段），可映射到数据库表、消息结构等"@zh ;
    rdfs:subClassOf owl:Thing .

### 12. 数据存储（Data Store）
:DataStore rdf:type owl:Class ;
    rdfs:label "数据存储"@zh ;
    rdfs:comment "持久化存储区域（如数据库、文件系统），可被多个流程共享"@zh ;
    rdfs:subClassOf owl:Thing .

### 13. 参与者（Participant）
:Participant rdf:type owl:Class ;
    rdfs:label "参与者"@zh ;
    rdfs:comment "执行流程或活动的角色、组织或系统，可与 bmm:OrganizationUnit 关联"@zh ;
    rdfs:subClassOf owl:Thing .

# ============================================================
# 二、对象属性（Object Properties）
# ============================================================

### 流程包含节点（活动、网关、事件）
:containsNode rdf:type owl:ObjectProperty ;
    rdfs:label "包含节点"@zh ;
    rdfs:domain bmm:BusinessProcess ;
    rdfs:range :FlowNode ;
    rdfs:comment "流程包含流节点（活动、网关、事件）"@zh .

### 节点具有出站顺序流
:hasSequenceFlow rdf:type owl:ObjectProperty ;
    rdfs:label "具有顺序流"@zh ;
    rdfs:domain :FlowNode ;
    rdfs:range :SequenceFlow ;
    rdfs:comment "节点拥有出站顺序流"@zh .

### 顺序流的源和目标
:sourceRef rdf:type owl:ObjectProperty ;
    rdfs:label "源"@zh ;
    rdfs:domain :SequenceFlow ;
    rdfs:range :FlowNode ;
    rdfs:comment "顺序流的起始节点"@zh .

:targetRef rdf:type owl:ObjectProperty ;
    rdfs:label "目标"@zh ;
    rdfs:domain :SequenceFlow ;
    rdfs:range :FlowNode ;
    rdfs:comment "顺序流的终止节点"@zh .

### 活动与数据实体
:usesData rdf:type owl:ObjectProperty ;
    rdfs:label "使用数据"@zh ;
    rdfs:domain :Activity ;
    rdfs:range :DataEntity ;
    rdfs:comment "活动读取数据实体"@zh .

:producesData rdf:type owl:ObjectProperty ;
    rdfs:label "产生数据"@zh ;
    rdfs:domain :Activity ;
    rdfs:range :DataEntity ;
    rdfs:comment "活动产生（写入）数据实体"@zh .

### 数据实体存储位置
:storedIn rdf:type owl:ObjectProperty ;
    rdfs:label "存储于"@zh ;
    rdfs:domain :DataEntity ;
    rdfs:range :DataStore ;
    rdfs:comment "数据实体持久化于某个数据存储"@zh .

### 活动与参与者
:performedBy rdf:type owl:ObjectProperty ;
    rdfs:label "由...执行"@zh ;
    rdfs:domain :Activity ;
    rdfs:range :Participant ;
    rdfs:comment "活动由参与者执行"@zh .

### 业务规则任务关联BMM业务规则
:executesRule rdf:type owl:ObjectProperty ;
    rdfs:label "执行业务规则"@zh ;
    rdfs:domain :BusinessRuleTask ;
    rdfs:range bmm:BusinessRule ;
    rdfs:comment "业务规则任务执行某条BMM业务规则"@zh .

### 顺序流条件（网关分支条件）
:hasCondition rdf:type owl:ObjectProperty ;
    rdfs:label "具有条件"@zh ;
    rdfs:domain :SequenceFlow ;
    rdfs:range owl:Thing ;  # 可进一步指定为表达式对象
    rdfs:comment "顺序流附带的控制条件（如EL表达式）"@zh .

### 参与者与组织机构关联（可选）
:belongsToOrganization rdf:type owl:ObjectProperty ;
    rdfs:label "属于组织"@zh ;
    rdfs:domain :Participant ;
    rdfs:range bmm:OrganizationUnit ;
    rdfs:comment "参与者归属于某个组织机构"@zh .

### （可选）流程与BMM行动方案的关联（通过BMM已有关系，但不重复定义）
# 直接使用 bmm:realizedBy / bmm:realizesProcess 已在BMM中定义，
# 可通过在BMM实例中使用 bmm:realizedBy :SomeProcess 来关联。

# ============================================================
# 四、基数约束（Cardinality Restrictions）
# ============================================================

### 流程必须至少包含一个节点（最小有一个开始事件等）
bmm:BusinessProcess rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :containsNode ;
    owl:minCardinality 1 ;
    rdfs:comment "流程必须包含至少一个流节点"@zh
] .

### 顺序流必须有且仅有一个源和一个目标
:SequenceFlow rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :sourceRef ;
    owl:cardinality 1 ;
    rdfs:comment "顺序流必须恰好有一个源节点"@zh
] .

:SequenceFlow rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty :targetRef ;
    owl:cardinality 1 ;
    rdfs:comment "顺序流必须恰好有一个目标节点"@zh
] .

### 开始事件不应有入站顺序流（此约束需借助SHACL或规则，此处仅做注释）
# 建议在应用层检查：StartEvent 不能被任何 SequenceFlow 作为 targetRef。

### 结束事件不应有出站顺序流（类似约束）
# 建议应用层检查：EndEvent 不能有 hasSequenceFlow。

# ============================================================
# 五、使用示例（Individuals）
# ============================================================

### 示例：采购审批流程
# :Process_采购审批 a bmm:BusinessProcess ;
#     :name "采购审批流程"@zh ;
#     :containsNode :Start_采购申请 , :Activity_经理审批 , :Gateway_金额判断 , :End_通过 .
#
# :Start_采购申请 a :StartEvent ;
#     :name "提交采购申请"@zh ;
#     :triggerType "无"@zh .
#
# :End_通过 a :EndEvent ;
#     :name "审批通过"@zh .
#
# :Flow_StartToApprove a :SequenceFlow ;
#     :sourceRef :Start_采购申请 ;
#     :targetRef :Activity_经理审批 .
#
# :Activity_经理审批 a :UserTask ;
#     :name "经理审批"@zh ;
#     :performedBy :Role_经理 .
#
# # 后续节点类似...