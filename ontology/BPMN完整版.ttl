@prefix : <http://example.org/bpmn#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bodhi: <http://example.org/bodhi#> .
@prefix bmm: <http://example.org/bmm#> .

# =====================================================================
# BPMN 业务流程模型（**按需子集**）（2026-10-11 新增）
#
# 参考 **BPMN 2.0**，但只落**当前需要的概念**：活动 / 任务 / 业务对象 / 角色，
# 以及关键关联：**活动 ↔ 业务流程**（`processHasActivity` → bmm:BusinessProcess）、
# **任务 → 业务规则**（`taskExecutesRule` → bmm:BusinessRule，故本模块 **imports bmm**）、
# **任务 → 角色**（`taskHasRole` → `Role`）、**活动 → 报告**（`activityProducesReport` → bmm:Report）。
# `agent.ttl` **imports bpmn**：**智能体协助活动**（`agent:agentAssistsActivity`）。
# 刻意**不落**：SequenceFlow / Gateway（顺序不固化）、Message / Collaboration / Choreography。
# =====================================================================
<http://example.org/bpmn> rdf:type owl:Ontology ;
    rdfs:label "BPMN业务流程模型（按需子集）"@zh ;
    rdfs:comment "BPMN 2.0 的按需子集：活动/任务/业务对象/角色 + 活动↔业务流程、任务→业务规则、任务→角色。imports bmm。"@zh ;
    bodhi:expertRole "业务流程建模专家，熟悉 BPMN 2.0 与业务规则落地"@zh .

# ============ 1. 活动 Activity（BPMN: Activity） ============
:Activity rdf:type owl:Class ;
    rdfs:label "活动"@zh ;
    rdfs:comment "流程中的**工作单元**（BPMN Activity）。本工程口径：一个活动产出**一份报告**（过程件）+ **一批资产**（entity）；活动有明确的**启动条件**与**结束条件**（结束条件含「对该模型范围质检 + 问题项反馈」）。"@zh ;
    rdfs:subClassOf owl:Thing .

# ============ 2. 任务 Task（BPMN: Task ⊂ Activity） ============
# 口径（2026-10-11 用户修订）：**为达成某个目标、由一个角色连续执行的工作单元**。
# · **角色**用**关系**表达（`:taskHasRole` → `:Role`，角色实例在各**领域库**定义）；**目标**用 `taskGoal`；
# · 人工 / 自动 / 线下取决于**实现的手段** —— 不建数据属性（需要时在活动/任务页说明），**不分子类**；
# · 任务执行**业务规则**（`taskExecutesRule` → `bmm:BusinessRule`），可由**智能体协助**（`agent:agentAssistsActivity`）。
:Task rdf:type owl:Class ;
    rdfs:label "任务"@zh ;
    rdfs:comment "为达成某个目标、由一个角色**连续执行**的工作单元（BPMN Task，是 Activity 的一种）：**角色**用关系表达（`taskHasRole`），**目标**用 `taskGoal`；执行一条/一组业务规则。"@zh ;
    rdfs:subClassOf :Activity .

# ============ 3. 业务对象 DataObject（BPMN: DataObject） ============
:DataObject rdf:type owl:Class ;
    rdfs:label "业务对象"@zh ;
    rdfs:comment "活动/任务读写的**业务对象**（BPMN DataObject）：技术方案、系统、设备申请、技术栈、认证清单…。**各领域模型里的「业务对象」类建议继承本类**（`rdfs:subClassOf bpmn:DataObject`），使「数据从哪来、到哪去」可查。"@zh ;
    rdfs:subClassOf owl:Thing .

# ============ 4.（业务属性 Property：**2026-10-11 用户口径先去除**）============
# 需要时再回来：BPMN Property 表达"流程范围内的属性"；当前用 OWL 数据属性承载即可。

# ============ 4. 角色 Role（2026-10-11 新增；**概念 + 关系，不是数据属性**）============
# 各领域建模时**定义自己的角色**（如评审组长 / 评审专家）—— 实例落各自**领域知识库**。
:Role rdf:type owl:Class ;
    rdfs:label "角色"@zh ;
    rdfs:comment "承担任务的主体类型（如评审组长 / 评审专家）：**由各领域在自己的领域知识库里定义实例**；任务通过 `:taskHasRole` 关联角色。人工/自动/线下由**实现的手段**决定，故不建子类。"@zh ;
    rdfs:subClassOf owl:Thing .

# ============ 关系（对象属性） ============
:processHasActivity rdf:type owl:ObjectProperty ;
    rdfs:label "包含活动"@zh ;
    rdfs:domain bmm:BusinessProcess ;
    rdfs:range :Activity ;
    rdfs:comment "业务流程包含活动（BPMN Process → flowElement）：**「企业知识管理流程」→ A1 立项与需求分析 / A2 设计与规划 / A3 开发交付 / A4 评测**。"@zh .

:activityProducesReport rdf:type owl:ObjectProperty ;
    rdfs:label "产出报告"@zh ;
    rdfs:domain :Activity ;
    rdfs:range bmm:Report ;
    rdfs:comment "活动产出**报告**（过程件）—— 报告与活动**一一对应**：需求分析报告 / 设计单 / 安装指引 / 评测方案 / 评测报告 / 结项报告。"@zh .

:activityUsesDataObject rdf:type owl:ObjectProperty ;
    rdfs:label "使用业务对象"@zh ;
    rdfs:domain :Activity ;
    rdfs:range :DataObject ;
    rdfs:comment "活动读写的业务对象（输入/输出对象）。"@zh .

:taskHasRole rdf:type owl:ObjectProperty ;
    rdfs:label "由角色执行"@zh ;
    rdfs:domain :Task ;
    rdfs:range :Role ;
    rdfs:comment "任务由**角色**执行（角色是**概念+关系**，不是数据属性）；角色实例在领域知识库里定义。"@zh .

:taskExecutesRule rdf:type owl:ObjectProperty ;
    rdfs:label "执行规则"@zh ;
    rdfs:domain :Task ;
    rdfs:range bmm:BusinessRule ;
    rdfs:comment "任务执行业务规则（**所以本模块 imports bmm**）：如「评审任务」执行 R1 最低部署与灾备要求 / R2 开源软件适用规则。"@zh .

# ============ 数据属性 ============
:activityId rdf:type owl:DatatypeProperty ;
    rdfs:label "活动编号"@zh ;
    rdfs:domain :Activity ;
    rdfs:range xsd:string ;
    rdfs:comment "活动稳定 id（如 `a1-requirement-analysis`）。"@zh .

:activityEntry rdf:type owl:DatatypeProperty ;
    rdfs:label "启动条件"@zh ;
    rdfs:domain :Activity ;
    rdfs:range xsd:string ;
    rdfs:comment "启动条件（缺一不可）：输入的文档/报告 + **声明的本体模型范围** + 产出物与反馈人。"@zh .

:activityExit rdf:type owl:DatatypeProperty ;
    rdfs:label "结束条件"@zh ;
    rdfs:domain :Activity ;
    rdfs:range xsd:string ;
    rdfs:comment "结束条件：报告落库 + **对该模型范围质检** + **问题项明确反馈**（现象·证据·处理·责任人·时间）。"@zh .

:activityScopeModel rdf:type owl:DatatypeProperty ;
    rdfs:label "模型范围"@zh ;
    rdfs:domain :Activity ;
    rdfs:range xsd:string ;
    rdfs:comment "本活动声明的**本体模型范围**（律五），如 `bmm` 或 `bmm,ea`；结束前按它做越界质检（律六）。"@zh .

:activityRound rdf:type owl:DatatypeProperty ;
    rdfs:label "轮次"@zh ;
    rdfs:domain :Activity ;
    rdfs:range xsd:integer ;
    rdfs:comment "第几轮（第二轮、第三轮…）：每轮评审都**更新同一份报告**（同 slug 覆盖、版本+1）。"@zh .

:taskGoal rdf:type owl:DatatypeProperty ;
    rdfs:label "实现的目标"@zh ;
    rdfs:domain :Task ;
    rdfs:range xsd:string ;
    rdfs:comment "该任务要达成的目标（用户口径：任务 = 为达成某个目标、由一个角色连续执行的工作单元）。"@zh .


# 模块短名（目录名/列表名；≤16 字符，导入时校验）
<http://example.org/bpmn> bodhi:shortName "BPMN流程模型" .

# ============================================================
# 2026-10-16（用户口径）：活动/任务/业务对象/系统的骨架关系
#   · activityContainsTask        活动包含任务（原来缺）
#   · taskUsesDataObject          任务的输入/输出（读写）
#   · dataObjectBelongsToTask     **权威维护**：数据对象归属哪个任务（从 DataObject 出发）
#   · taskImplementedBySubSystem  任务由哪个系统实现 ⇒ 与上一条合起来推导
#       「数据对象 → 归属任务 → 实现系统 = 唯一权威来源」，其它系统只能经 taskUsesDataObject 作**副本**
#     （这是后续架构管控的基础结构；不用任何 sourceOfTruth 标记）
# ============================================================
:activityContainsTask a owl:ObjectProperty ;
    rdfs:label "活动包含任务"@zh ;
    rdfs:domain :Activity ;
    rdfs:range :Task ;
    rdfs:comment "活动下的任务（活动=一组任务；任务的规则绑定见 taskExecutesRule）"@zh .

:taskUsesDataObject a owl:ObjectProperty ;
    rdfs:label "任务读写业务对象"@zh ;
    rdfs:domain :Task ;
    rdfs:range :DataObject ;
    rdfs:comment "任务的输入/输出（读写）。**不代表权威**：权威由 dataObjectBelongsToTask + taskImplementedBySubSystem 推导"@zh .

:dataObjectBelongsToTask a owl:ObjectProperty ;
    rdfs:label "业务对象归属任务"@zh ;
    rdfs:domain :DataObject ;
    rdfs:range :Task ;
    rdfs:comment "**权威维护关系**：业务对象（正本）归属哪个任务；与 taskImplementedBySubSystem 合起来给出唯一权威系统。每个对象**恰有一个**归属任务"@zh .

:taskImplementedBySubSystem a owl:ObjectProperty ;
    rdfs:label "任务实现系统"@zh ;
    rdfs:domain :Task ;
    rdfs:range bmm:SubSystem ;
    rdfs:comment "任务由哪个系统实现/承载（如『问题管理』由 IT 工作平台承载）⇒ 该任务归属对象的权威系统"@zh .

# ============================================================
# 2026-10-16（用户口径 · 第 5 条）：**任务执行策略**
#   任务 → 策略 → （策略包含）规则 ⇒ 与"任务 → 规则"（taskExecutesRule）**并存**：
#   · 直接路径：Task --taskExecutesRule--> BusinessRule
#   · 间接路径：Task --taskExecutesPolicy--> BusinessPolicy --isBasisFor--> BusinessRule
#   检索工具（knowledge_lookup 模式二）应先用 ontology_paths 找**全部路径**；
#   多条时让用户选一条或取**并集** ⇒ 这正是"规则搜索成功率"的验证场景。
# ============================================================
:taskExecutesPolicy a owl:ObjectProperty ;
    rdfs:label "任务执行策略"@zh ;
    rdfs:domain :Task ;
    rdfs:range <http://example.org/bmm#BusinessPolicy> ;
    rdfs:comment "任务按哪条业务策略执行（策略包含的规则构成判定的间接路径；与 taskExecutesRule 直接绑定并存）"@zh .
